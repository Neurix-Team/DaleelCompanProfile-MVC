@model Daleel.Models.PlatformsPageViewModel
@{
    var isRtl = System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar");
    var brandName = isRtl ? (Model.Brand?.NameAr ?? "دليل") : (Model.Brand?.NameEn ?? "Daleel");
    ViewData["Title"] = isRtl ? $"المنصات والحلول - {brandName}" : $"Platforms & Solutions - {brandName}";

    // CMS-editable page sections. A blank value inherits the brand/built-in copy below.
    var content = ViewData.PageContent();
}

@functions {
    public string ToLocalNumerals(string input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;
        if (System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar"))
        {
            string replaced = input.Replace("M", " مليون")
                                   .Replace("K", " ألف")
                                   .Replace("min", " دقائق")
                                   .Replace("-in-", " في ")
                                   .Replace('0', '٠')
                                   .Replace('1', '١')
                                   .Replace('2', '٢')
                                   .Replace('3', '٣')
                                   .Replace('4', '٤')
                                   .Replace('5', '٥')
                                   .Replace('6', '٦')
                                   .Replace('7', '٧')
                                   .Replace('8', '٨')
                                   .Replace('9', '٩');
                                   
            if (replaced.EndsWith("+"))
            {
                replaced = "+" + replaced.TrimEnd('+');
            }
            
            return replaced;
        }
        return input;
    }
}

<section class="relative bg-white dark:bg-[#0A192F] py-24 sm:py-32 overflow-hidden transition-colors duration-300">

    <!-- Ambient Background Glows -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute top-1/4 ltr:-right-40 rtl:-left-40 w-[600px] h-[600px] rounded-full bg-[#00B2EC]/5 blur-[120px]"></div>
        <div class="absolute bottom-0 ltr:-left-20 rtl:-right-20 w-[500px] h-[500px] rounded-full bg-[#10B981]/5 blur-[100px]"></div>
    </div>

    <div class="relative z-10 max-w-[1440px] mx-auto px-6 sm:px-8">

        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20" data-animate="fade-up">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-[#00B2EC]/10 via-[#10B981]/10 to-[#fdc70c]/10 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-300 font-['Inter'] text-xs font-semibold tracking-wide mb-6">
                <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">layers</span>
                @(isRtl ? "المنصات المؤسسية المتخصصة" : "Core Enterprise Platforms")
            </div>
            <h1 class="font-['Poppins'] text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 dark:text-white leading-tight mb-6">
                @content.Section("platforms_title", isRtl ? $"حلول ومنظومات {brandName}" : $"{brandName} Intelligent Platforms")
            </h1>
            <p class="font-['Inter'] text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
                @content.Section("platforms_desc", isRtl ? (Model.Brand?.DescriptionAr ?? "منظومات ذكاء اصطناعي وأدوات تحليلات تنبؤية مصممة للارتقاء بالأداء الاستراتيجي.") : (Model.Brand?.DescriptionEn ?? "Enterprise intelligence engines and predictive analytics infrastructure tailored for market dominance."))
            </p>
        </div>

        <!-- Dynamic CMS Services List -->
        <div class="space-y-16">
            @{
                var colors = new[] { "#00B2EC", "#10B981", "#F9A01B", "#8B5CF6" };
                var index = 0;
            }
            @foreach (var s in Model.Services)
            {
                var accent = colors[index % colors.Length];
                var serviceName = isRtl ? s.NameAr : s.NameEn;
                var serviceShortDesc = isRtl ? s.ShortDescAr : s.ShortDescEn;
                var isEven = index % 2 == 1;
                index++;

                <div class="bg-[#F8F9FA] dark:bg-[#060D1A] rounded-3xl p-8 sm:p-12 border border-slate-200 dark:border-white/10 shadow-sm hover:border-[#00B2EC]/30 transition-all duration-500">
                    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                        <div class="lg:col-span-8 space-y-6 @(isEven ? "lg:order-2" : "lg:order-1") text-start">
                            <div class="flex items-center gap-4">
                                <div class="w-14 h-14 rounded-2xl flex items-center justify-center shadow-sm" style="background-color: @(accent)15; color: @accent;">
                                    <span class="material-symbols-outlined text-[28px]" style="font-variation-settings: 'FILL' 1;">
                                        @(!string.IsNullOrWhiteSpace(s.IconName) ? s.IconName : "dataset")
                                    </span>
                                </div>
                                <div>
                                    <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full" style="background-color: @(accent)15; color: @accent;">
                                        Platform #@index
                                    </span>
                                    <h2 class="font-poppins font-bold text-2xl sm:text-3xl text-brand-navy dark:text-white mt-1">
                                        @serviceName
                                    </h2>
                                </div>
                            </div>

                            <p class="font-['Inter'] text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed">
                                @serviceShortDesc
                            </p>
                        </div>

                        <div class="lg:col-span-4 @(isEven ? "lg:order-1" : "lg:order-2")">
                            <div class="p-6 rounded-2xl bg-white dark:bg-[#0A192F] border border-slate-200 dark:border-white/10 space-y-4 text-start">
                                <h3 class="font-poppins font-semibold text-sm text-brand-navy dark:text-white flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[18px]" style="color: @accent;">verified</span>
                                    <span>@(isRtl ? "المواصفات المؤسسية" : "Enterprise Capabilities")</span>
                                </h3>
                                <ul class="space-y-2.5 text-xs text-slate-600 dark:text-slate-400">
                                    <li class="flex items-center gap-2">
                                        <span class="w-1.5 h-1.5 rounded-full" style="background-color: @accent;"></span>
                                        <span>@(isRtl ? "تكامل سحابي فوري ومستمر" : "Real-time Cloud Telemetry")</span>
                                    </li>
                                    <li class="flex items-center gap-2">
                                        <span class="w-1.5 h-1.5 rounded-full" style="background-color: @accent;"></span>
                                        <span>@(isRtl ? "حماية وامتثال وفق المعايير الدولية" : "Enterprise Compliance & Governance")</span>
                                    </li>
                                    <li class="flex items-center gap-2">
                                        <span class="w-1.5 h-1.5 rounded-full" style="background-color: @accent;"></span>
                                        <span>@(isRtl ? "واجهات برمجية API مرنة وقابلة للتوسع" : "High-throughput API Access")</span>
                                    </li>
                                </ul>
                                <div class="pt-4 border-t border-slate-100 dark:border-white/5">
                                    <a asp-controller="Home" asp-action="ScheduleDemo"
                                       class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-white text-xs font-semibold shadow-md hover:opacity-95 transition-all"
                                       style="background-color: @accent;">
                                        <span class="material-symbols-outlined text-[16px]">calendar_month</span>
                                        <span>@(isRtl ? "طلب عرض تجريبي" : "Request Platform Demo")</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Featured Projects in Platforms Page -->
        @if (Model.Projects.Count > 0)
        {
            <div class="mt-24 pt-20 border-t border-slate-200 dark:border-white/10">
                <div class="text-center max-w-3xl mx-auto mb-16" data-animate="fade-up">
                    <h2 class="font-poppins font-bold text-3xl text-brand-navy dark:text-white mb-3">
                        @(isRtl ? "مشاريع وأنظمة تم تسليمها" : "Deployed Systems & Case Studies")
                    </h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        @(isRtl ? "استكشف نماذج من المنظومات الرقمية المتكاملة التي تديرها منصاتنا." : "Explore live implementations powered by our intelligent platform architecture.")
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    @foreach (var p in Model.Projects)
                    {
                        var projName = isRtl ? p.NameAr : p.NameEn;
                        var projShortDesc = isRtl ? p.ShortDescAr : p.ShortDescEn;
                        var clientName = isRtl ? p.ClientNameAr : p.ClientNameEn;

                        <div class="bg-[#F8F9FA] dark:bg-[#060D1A] rounded-3xl border border-slate-200 dark:border-white/10 overflow-hidden shadow-sm flex flex-col justify-between group">
                            <div>
                                <div class="relative h-48 bg-slate-200 dark:bg-white/5 overflow-hidden">
                                    @if (!string.IsNullOrWhiteSpace(p.ImagePath))
                                    {
                                        <img src="@p.ImagePath" alt="@projName" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                    }
                                    else
                                    {
                                        <div class="w-full h-full flex items-center justify-center bg-gradient-to-tr from-[#00B2EC]/20 to-[#10B981]/20">
                                            <span class="material-symbols-outlined text-[40px] text-[#00B2EC]">grid_view</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(clientName))
                                    {
                                        <span class="absolute bottom-3 start-3 px-3 py-1 rounded-full text-xs font-semibold bg-white/90 dark:bg-black/70 backdrop-blur-md text-brand-navy dark:text-white">
                                            @clientName
                                        </span>
                                    }
                                </div>
                                <div class="p-6">
                                    <h3 class="font-poppins font-bold text-lg text-brand-navy dark:text-white group-hover:text-[#00B2EC] transition-colors mb-2">
                                        @projName
                                    </h3>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-3 leading-relaxed">
                                        @projShortDesc
                                    </p>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(p.ProjectUrl))
                            {
                                <div class="px-6 py-4 bg-white/50 dark:bg-white/[0.02] border-t border-slate-100 dark:border-white/5">
                                    <a href="@p.ProjectUrl" target="_blank" class="inline-flex items-center gap-2 text-xs font-bold text-[#00B2EC] hover:gap-3 transition-all">
                                        <span>@(isRtl ? "معاينة النظام" : "View Live System")</span>
                                        <span class="material-symbols-outlined text-[16px] rtl:rotate-180">open_in_new</span>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</section>
