@model Daleel.Models.AboutPageViewModel
@{
    var isRtl = System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar");
    var brandName = isRtl ? (Model.Brand?.NameAr ?? "دليل") : (Model.Brand?.NameEn ?? "Daleel");
    var brandTagline = isRtl ? (Model.Brand?.TaglineAr ?? "الرؤية العالمية، الدقة المحلية") : (Model.Brand?.TaglineEn ?? "Global Vision, Local Precision");
    ViewData["Title"] = isRtl ? $"عن الشركة - {brandName}" : $"About Us - {brandName}";

    // CMS-editable page sections. A blank value inherits the brand/built-in copy below.
    var content = ViewData.PageContent();
}

<section class="relative py-24 sm:py-32 overflow-hidden transition-colors duration-300">
    <!-- Ambient Background Glows -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute top-10 right-10 w-[600px] h-[600px] rounded-[100%] bg-[#10B981]/10 blur-[120px] dark:bg-[#10B981]/5"></div>
        <div class="absolute bottom-10 left-10 w-[500px] h-[500px] rounded-[100%] bg-[#00B2EC]/10 blur-[100px] dark:bg-[#00B2EC]/5"></div>
    </div>

    <div class="relative z-10 max-w-[1440px] mx-auto px-6 sm:px-8">

        <!-- Hero Content -->
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center mb-24">
            <div class="text-start" data-animate="fade-up">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-[#00B2EC]/10 via-[#10B981]/10 to-[#fdc70c]/10 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-300 font-['Inter'] text-xs font-semibold tracking-wide mb-6">
                    <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">public</span>
                    @(isRtl ? "قصة المنظومة والريادة" : "Our Story & Vision")
                </div>
                <h1 class="font-['Poppins'] text-4xl sm:text-5xl md:text-6xl font-bold text-slate-900 dark:text-white leading-tight mb-6">
                    @content.Section("about_title", isRtl ? $"عن منظومة {brandName}" : $"About {brandName}") <br/><span class="text-gradient">@brandTagline</span>
                </h1>
                <p class="font-['Inter'] text-lg sm:text-xl text-slate-600 dark:text-slate-400 leading-relaxed mb-8">
                    @content.Section("about_desc", isRtl ? (Model.Brand?.DescriptionAr ?? SharedLocalizer["AboutDesc"].Value) : (Model.Brand?.DescriptionEn ?? SharedLocalizer["AboutDesc"].Value))
                </p>
                <div class="border-t border-slate-200 dark:border-white/10 pt-8 flex items-center gap-6">
                    <div>
                        <p class="font-poppins font-bold text-2xl text-[#00B2EC]">15+</p>
                        <p class="text-xs text-slate-400">@(isRtl ? "سنوات خبرة مؤسسية" : "Years Domain Experience")</p>
                    </div>
                    <div class="w-px h-10 bg-slate-200 dark:bg-white/10"></div>
                    <div>
                        <p class="font-poppins font-bold text-2xl text-[#10B981]">100%</p>
                        <p class="text-xs text-slate-400">@(isRtl ? "امتثال لمعايير الحوكمة" : "Enterprise Governance")</p>
                    </div>
                    <div class="w-px h-10 bg-slate-200 dark:bg-white/10"></div>
                    <div>
                        <p class="font-poppins font-bold text-2xl text-[#F9A01B]">24/7</p>
                        <p class="text-xs text-slate-400">@(isRtl ? "استجابة ذكية مستمرة" : "Intelligent Telemetry")</p>
                    </div>
                </div>
            </div>

            <div class="relative group" data-animate="fade-up" data-delay="1">
                <div class="absolute inset-0 bg-gradient-to-tr from-[#00B2EC]/20 to-transparent rounded-[2rem] transform translate-x-4 translate-y-4 group-hover:translate-x-6 group-hover:translate-y-6 transition-transform duration-700"></div>
                <div class="relative bg-white dark:bg-[#0A192F] rounded-[2rem] p-3 shadow-2xl border border-slate-100 dark:border-slate-800 overflow-hidden">
                    <img src="@content.Section("about_hero_image", "/images/homepage/ai_predictive_1777586859142.png")"
                        alt="Daleel Global Vision Team"
                        class="w-full h-auto aspect-[4/3] object-cover rounded-xl group-hover:scale-105 transition-transform duration-700 ease-out" />
                </div>
            </div>
        </div>

        <!-- Mission & Purpose -->
        <div class="glass-card rounded-[2rem] p-10 md:p-16 text-center max-w-4xl mx-auto mb-24" data-animate="scale-in" data-delay="2">
            <span class="material-symbols-outlined text-[#00B2EC] text-[48px] mb-6" style="font-variation-settings: 'FILL' 1;">explore</span>
            <h2 class="font-['Poppins'] text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-6">
                @(isRtl ? "مهمتنا ورسالتنا" : "Our Mission")
            </h2>
            <p class="font-['Inter'] text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed italic">
                @(isRtl ? "تمكين المؤسسات والقيادات الاستراتيجية بأدوات ذكاء الأعمال والتحليلات التنبؤية المتطورة لصناعة قرارات استباقية تصنع الفارق." : "Empower enterprises and visionary leadership with deep predictive intelligence and real-time operational clarity for decisive market impact.")
            </p>
        </div>

        <!-- Dynamic CMS Team Members Section -->
        @if (Model.TeamMembers.Count > 0)
        {
            <div class="mb-24">
                <div class="text-center max-w-3xl mx-auto mb-16" data-animate="fade-up">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#00B2EC]/10 text-[#00B2EC] font-['Inter'] text-xs font-semibold tracking-wide mb-6">
                        <span class="material-symbols-outlined text-[14px]">groups</span>
                        @(isRtl ? "الفريق والقيادة التنفيذية" : "Leadership & Brain Trust")
                    </div>
                    <h2 class="font-['Poppins'] text-3xl sm:text-4xl md:text-5xl font-bold text-brand-navy dark:text-white leading-tight mb-6">
                        @(isRtl ? "فريق يقود الابتكار" : "Architects of Intelligent Transformation")
                    </h2>
                    <p class="font-['Inter'] text-base sm:text-lg text-slate-500 dark:text-slate-400 leading-relaxed">
                        @(isRtl ? "نخبة من خبراء الذكاء الاصطناعي وهندسة البيانات والتحول الرقمي المكرسين لنجاح عملائنا." : "A world-class team of machine learning scientists, systems architects, and enterprise strategists.")
                    </p>
                </div>

                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    @foreach (var m in Model.TeamMembers)
                    {
                        var memberName = isRtl ? m.NameAr : m.NameEn;
                        var memberTitle = isRtl ? m.TitleAr : m.TitleEn;
                        var memberBio = isRtl ? m.BioAr : m.BioEn;

                        <div class="bg-white dark:bg-[#060D1A] rounded-3xl p-8 border border-slate-200 dark:border-white/10 shadow-sm hover:border-[#00B2EC]/40 hover:-translate-y-2 transition-all duration-500 flex flex-col items-center text-center group">
                            <!-- Photo -->
                            <div class="relative mb-6">
                                @if (!string.IsNullOrWhiteSpace(m.PhotoPath))
                                {
                                    <img src="@m.PhotoPath" alt="@memberName" class="w-28 h-28 rounded-full object-cover border-4 border-slate-100 dark:border-[#112240] shadow-lg group-hover:scale-105 transition-transform duration-500" />
                                }
                                else
                                {
                                    <div class="w-28 h-28 rounded-full bg-[#00B2EC]/10 flex items-center justify-center border-4 border-slate-100 dark:border-[#112240] shadow-lg">
                                        <span class="material-symbols-outlined text-[48px] text-[#00B2EC]">person</span>
                                    </div>
                                }
                            </div>

                            <h3 class="font-poppins font-bold text-xl text-brand-navy dark:text-white group-hover:text-[#00B2EC] transition-colors mb-1">
                                @memberName
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(memberTitle))
                            {
                                <p class="text-xs font-semibold uppercase tracking-wider text-[#00B2EC] mb-4">
                                    @memberTitle
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(memberBio))
                            {
                                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed line-clamp-3 mb-6">
                                    @memberBio
                                </p>
                            }

                            <!-- Social Links -->
                            <div class="flex items-center gap-3 mt-auto pt-4 border-t border-slate-100 dark:border-white/5 w-full justify-center">
                                @if (!string.IsNullOrWhiteSpace(m.Email))
                                {
                                    <a href="mailto:@m.Email" class="w-8 h-8 rounded-full bg-slate-50 dark:bg-white/5 flex items-center justify-center text-slate-400 hover:text-[#00B2EC] transition-colors" title="@m.Email">
                                        <span class="material-symbols-outlined text-[16px]">email</span>
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(m.LinkedInUrl))
                                {
                                    <a href="@m.LinkedInUrl" target="_blank" class="w-8 h-8 rounded-full bg-slate-50 dark:bg-white/5 flex items-center justify-center text-slate-400 hover:text-[#0077B5] transition-colors" title="LinkedIn">
                                        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</section>
