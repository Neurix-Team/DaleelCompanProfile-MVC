@model Daleel.Models.PartnerRegistrationViewModel
@{
    ViewData["Title"] = "Partner Registration";
    bool isSuccess = TempData["PartnerSuccess"] != null && (bool)TempData["PartnerSuccess"]!;
}

<section class="relative py-32 overflow-hidden transition-colors duration-300">
    <!-- Ambient Background Glows -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute top-10 left-10 w-[600px] h-[600px] rounded-[100%] bg-[#10B981]/10 blur-[120px] dark:bg-[#10B981]/5"></div>
    </div>

    <div class="relative z-10 max-w-[1440px] mx-auto px-6 sm:px-8">

        <!-- Page Header -->
        <div class="text-center max-w-3xl mx-auto mb-20" data-animate="fade-up">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-th-sky/10 via-[#10B981]/10 to-[#fdc70c]/10 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-300 font-['Inter'] text-xs font-semibold tracking-wide mb-6">
                <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">handshake</span>
                @SharedLocalizer["BecomePartner"]
            </div>
            <h1 class="font-['Poppins'] text-4xl sm:text-5xl md:text-6xl font-bold text-slate-900 dark:text-white leading-tight mb-6">
                @SharedLocalizer["PartnerRegistrationHeading"]
            </h1>
            <p class="font-['Inter'] text-lg sm:text-xl text-slate-600 dark:text-slate-400 leading-relaxed">
                @SharedLocalizer["PartnerRegistrationDesc"]
            </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 max-w-6xl mx-auto">

            <!-- Partner Info / Benefits -->
            <div class="space-y-8" data-animate="fade-up" data-delay="1">
                <h2 class="font-['Poppins'] text-3xl font-bold text-slate-900 dark:text-white mb-8">@SharedLocalizer["PartnersGlobalNetwork"]</h2>

                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-th-sky/10 flex items-center justify-center shrink-0 mt-1">
                        <span class="material-symbols-outlined text-th-sky">public</span>
                    </div>
                    <div>
                        <h3 class="font-['Inter'] font-semibold text-slate-900 dark:text-white text-lg">@SharedLocalizer["TrueGlobalCoverage"]</h3>
                        <p class="font-['Inter'] text-slate-600 dark:text-slate-400 mt-2">@SharedLocalizer["GlobalCoverageDesc"]</p>
                    </div>
                </div>

                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-[#10B981]/10 flex items-center justify-center shrink-0 mt-1">
                        <span class="material-symbols-outlined text-[#10B981]">security</span>
                    </div>
                    <div>
                        <h3 class="font-['Inter'] font-semibold text-slate-900 dark:text-white text-lg">@SharedLocalizer["EnterpriseSecurity"]</h3>
                        <p class="font-['Inter'] text-slate-600 dark:text-slate-400 mt-2">@SharedLocalizer["EnterpriseSecurityDesc"]</p>
                    </div>
                </div>

                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-[#F9A01B]/10 flex items-center justify-center shrink-0 mt-1">
                        <span class="material-symbols-outlined text-[#F9A01B]">insights</span>
                    </div>
                    <div>
                        <h3 class="font-['Inter'] font-semibold text-slate-900 dark:text-white text-lg">@SharedLocalizer["RealTimeIntelligence"]</h3>
                        <p class="font-['Inter'] text-slate-600 dark:text-slate-400 mt-2">@SharedLocalizer["RealTimeIntDesc"]</p>
                    </div>
                </div>
            </div>

            <!-- Registration Form -->
            <div class="glass-card rounded-[2rem] p-8 sm:p-10" data-animate="scale-in" data-delay="2">
                @* Success banner (shown after successful PRG redirect) *@
                @if (isSuccess)
                {
                    <div id="partner-success-banner"
                         class="mb-6 flex items-start gap-3 rounded-xl border border-[#10B981]/25 bg-[#10B981]/10 px-5 py-4"
                         role="alert" aria-live="polite">
                        <span class="material-symbols-outlined text-[22px] text-[#10B981] mt-0.5"
                              style="font-variation-settings:'FILL' 1;">check_circle</span>
                        <div>
                            <p class="font-['Inter'] font-semibold text-[#10B981] text-sm">Application submitted successfully!</p>
                            <p class="font-['Inter'] text-slate-600 dark:text-slate-400 text-xs mt-1">
                                Our partnerships team will review your application and be in touch shortly.
                            </p>
                        </div>
                    </div>
                }

                @* Server-side model errors *@
                <div asp-validation-summary="ModelOnly"
                     class="mb-6 rounded-xl border border-red-300 bg-red-50 dark:bg-red-950/30 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-400 font-['Inter']">
                </div>

                <form asp-action="PartnerRegistration" asp-controller="Home" method="post" id="partner-form" class="space-y-6" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="grid grid-cols-2 gap-6">
                        <div class="col-span-2 sm:col-span-1">
                            <label asp-for="FirstName" class="block font-['Inter'] text-sm font-medium text-slate-900 dark:text-slate-300 mb-2">@SharedLocalizer["FirstName"] <span class="text-red-500">*</span></label>
                            <input asp-for="FirstName" id="partner-first-name" autocomplete="given-name" type="text" class="w-full bg-th-bg dark:bg-th-d-high border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-[#10B981] transition-all" placeholder="John" />
                            <span asp-validation-for="FirstName" class="mt-1.5 block text-xs text-red-500 font-['Inter']"></span>
                            <p id="partner-first-name-error" class="hidden text-red-500 text-xs mt-1 font-['Inter']">Must be at least 3 characters and contain only letters.</p>
                        </div>
                        <div class="col-span-2 sm:col-span-1">
                            <label asp-for="LastName" class="block font-['Inter'] text-sm font-medium text-slate-900 dark:text-slate-300 mb-2">@SharedLocalizer["LastName"] <span class="text-red-500">*</span></label>
                            <input asp-for="LastName" id="partner-last-name" autocomplete="family-name" type="text" class="w-full bg-th-bg dark:bg-th-d-high border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-[#10B981] transition-all" placeholder="Doe" />
                            <span asp-validation-for="LastName" class="mt-1.5 block text-xs text-red-500 font-['Inter']"></span>
                            <p id="partner-last-name-error" class="hidden text-red-500 text-xs mt-1 font-['Inter']">Must be at least 3 characters and contain only letters.</p>
                        </div>
                    </div>
                    
                    <div>
                        <label asp-for="CompanyName" class="block font-['Inter'] text-sm font-medium text-slate-900 dark:text-slate-300 mb-2">@SharedLocalizer["CompanyName"] <span class="text-red-500">*</span></label>
                        <input asp-for="CompanyName" id="partner-company" autocomplete="organization" type="text" class="w-full bg-th-bg dark:bg-th-d-high border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-[#10B981] transition-all" placeholder="Acme Corp" />
                        <span asp-validation-for="CompanyName" class="mt-1.5 block text-xs text-red-500 font-['Inter']"></span>
                        <p id="partner-company-error" class="hidden text-red-500 text-xs mt-1 font-['Inter']">Must be at least 3 characters and contain only letters.</p>
                    </div>

                    <div>
                        <label asp-for="Email" class="block font-['Inter'] text-sm font-medium text-slate-900 dark:text-slate-300 mb-2">@SharedLocalizer["WorkEmail"] <span class="text-red-500">*</span></label>
                        <input asp-for="Email" id="partner-email" autocomplete="email" type="email" class="w-full bg-th-bg dark:bg-th-d-high border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-[#10B981] transition-all" placeholder="john@company.com" />
                        <span asp-validation-for="Email" class="mt-1.5 block text-xs text-red-500 font-['Inter']"></span>
                        <p id="partner-email-error" class="hidden text-red-500 text-xs mt-1 font-['Inter']">Please enter a valid email address (e.g., name@domain.com).</p>
                    </div>

                    <div>
                        <label asp-for="PartnershipType" class="block font-['Inter'] text-sm font-medium text-slate-900 dark:text-slate-300 mb-2">@SharedLocalizer["PartnershipType"] <span class="text-red-500">*</span></label>
                        <div class="relative">
                            @* Stable, culture-independent values so the posted type is consistent in EN and AR *@
                            <select asp-for="PartnershipType" id="partner-type" class="w-full appearance-none !bg-none bg-th-bg dark:bg-th-d-high border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 pe-12 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#10B981] transition-all">
                                <option value="Technology Partner">@SharedLocalizer["TechnologyPartner"]</option>
                                <option value="Intelligence Partner">@SharedLocalizer["IntelligencePartner"]</option>
                                <option value="Strategic Partner">@SharedLocalizer["StrategicPartner"]</option>
                                <option value="Other">@SharedLocalizer["OtherPartner"]</option>
                            </select>
                            <div class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-4 text-slate-500 dark:text-slate-400">
                                <span class="material-symbols-outlined">expand_more</span>
                            </div>
                        </div>
                    </div>
                    
                    <div>
                        <label asp-for="Message" class="block font-['Inter'] text-sm font-medium text-slate-900 dark:text-slate-300 mb-2">@SharedLocalizer["Message"] <span class="text-red-500">*</span></label>
                        <textarea asp-for="Message" id="partner-message" rows="4" class="w-full bg-th-bg dark:bg-th-d-high border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-[#10B981] transition-all resize-none" placeholder="@SharedLocalizer["MessagePlaceholder"]"></textarea>
                        <span asp-validation-for="Message" class="mt-1.5 block text-xs text-red-500 font-['Inter']"></span>
                        <p id="partner-message-error" class="hidden text-red-500 text-xs mt-1 font-['Inter']">Message must be at least 3 characters.</p>
                    </div>

                    <button type="submit"
                        class="w-full bg-[#10B981] text-white px-8 py-4 rounded-xl font-['Inter'] font-semibold text-base shadow-lg shadow-[#10B981]/20 hover:shadow-xl hover:shadow-[#10B981]/30 active:scale-95 transition-all duration-300">
                        @SharedLocalizer["SubmitApplication"]
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        const form = document.getElementById('partner-form');
        const firstName = document.getElementById('partner-first-name');
        const lastName = document.getElementById('partner-last-name');
        const company = document.getElementById('partner-company');
        
        const firstNameError = document.getElementById('partner-first-name-error');
        const lastNameError = document.getElementById('partner-last-name-error');
        const companyError = document.getElementById('partner-company-error');
        const email = document.getElementById('partner-email');
        const emailError = document.getElementById('partner-email-error');
        const message = document.getElementById('partner-message');
        const messageError = document.getElementById('partner-message-error');

        function validateInput(input, errorElement, mode = 'name') {
            const val = input.value.trim();
            const isLengthValid = val.length >= 3;
            
            let isFormatValid = true;
            if (val.length > 0) {
                if (mode === 'name') {
                    isFormatValid = /^[\p{L}\s]+$/u.test(val);
                } else if (mode === 'company') {
                    isFormatValid = /^[\p{L}\s]+$/u.test(val);
                }
            }

            if (!isLengthValid || !isFormatValid) {
                errorElement.classList.remove('hidden');
                return false;
            } else {
                errorElement.classList.add('hidden');
                return true;
            }
        }

        function validateEmail(input, errorElement) {
            const val = input.value.trim();
            const emailRegex = /^[a-zA-Z0-9.]+@@[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$/;
            const localPart = val.split('@@')[0] || '';
            const startsWithDot = localPart.startsWith('.');
            const endsWithDot   = localPart.endsWith('.');
            const hasConsecDots = localPart.includes('..');
            if (!emailRegex.test(val) || startsWithDot || endsWithDot || hasConsecDots) {
                errorElement.classList.remove('hidden');
                return false;
            } else {
                errorElement.classList.add('hidden');
                return true;
            }
        }

        firstName.addEventListener('input', () => validateInput(firstName, firstNameError, 'name'));
        lastName.addEventListener('input', () => validateInput(lastName, lastNameError, 'name'));
        company.addEventListener('input', () => validateInput(company, companyError, 'company'));
        email.addEventListener('input', () => validateEmail(email, emailError));
        message.addEventListener('input', () => validateInput(message, messageError, 'message'));

        form.addEventListener('submit', function(e) {
            const isFirstValid = validateInput(firstName, firstNameError, 'name');
            const isLastValid = validateInput(lastName, lastNameError, 'name');
            const isCompanyValid = validateInput(company, companyError, 'company');
            const isEmailValid = validateEmail(email, emailError);
            const isMessageValid = validateInput(message, messageError, 'message');

            // Block only invalid submissions; valid ones post to the server,
            // which creates the CRM lead and redirects back with a success banner.
            if (!isFirstValid || !isLastValid || !isCompanyValid || !isEmailValid || !isMessageValid) {
                e.preventDefault();
            }
        });

        // Auto-fade the success banner after 8s
        var partnerBanner = document.getElementById('partner-success-banner');
        if (partnerBanner) {
            setTimeout(function () {
                partnerBanner.style.transition = 'opacity 0.6s ease';
                partnerBanner.style.opacity = '0';
                setTimeout(function () { partnerBanner.remove(); }, 700);
            }, 8000);
        }
    </script>
}
