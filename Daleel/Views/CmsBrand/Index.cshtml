@using System.Globalization
@model IReadOnlyList<Daleel.BAL.Models.BrandProfileListItemDto>
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = SharedLocalizer["CmsTitleCompanyBrandProfiles"].Value;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}

<div class="space-y-6">

    <!-- Header & Action Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="font-poppins text-2xl font-bold text-brand-navy dark:text-white">
                @SharedLocalizer["CmsTitleCompanyBrandProfiles"]
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                @SharedLocalizer["CmsBrandsIndexIntro"]
            </p>
        </div>
        <a asp-controller="CmsBrand" asp-action="Create"
           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-th-sky to-[#10B981] text-white font-semibold text-sm transition-all shadow-lg shadow-th-sky/20 hover:opacity-95 hover:scale-[1.02] self-start sm:self-auto">
            <span class="material-symbols-outlined text-[20px]">add_business</span>
            <span>@SharedLocalizer["CmsAddBrandProfile"]</span>
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    <!-- Brand Cards Grid -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="bg-th-card dark:bg-th-d-card p-12 text-center rounded-2xl border border-slate-200/80 dark:border-white/10">
            <span class="material-symbols-outlined text-slate-400 text-[48px] mb-3">domain_disabled</span>
            <h3 class="font-poppins font-bold text-lg text-slate-800 dark:text-slate-200">@SharedLocalizer["CmsNoBrandProfilesFound"]</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@SharedLocalizer["CmsNoBrandProfilesDesc"]</p>
            <a asp-controller="CmsBrand" asp-action="Create"
               class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-th-sky text-white text-sm font-semibold hover:opacity-90">
                @SharedLocalizer["CmsCreateBrand"]
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var brand in Model)
            {
                var displayName = isRtl && !string.IsNullOrWhiteSpace(brand.NameAr) ? brand.NameAr : brand.NameEn;
                var secondaryName = isRtl ? brand.NameEn : brand.NameAr;
                var tagline = isRtl && !string.IsNullOrWhiteSpace(brand.TaglineAr) ? brand.TaglineAr : brand.TaglineEn;

                <div class="bg-th-card dark:bg-th-d-card rounded-2xl border border-slate-200/80 dark:border-white/10 p-6 sm:p-7 shadow-sm hover:border-th-sky/40 transition-all flex flex-col justify-between group">
                    <div>
                        <!-- Top Row: Logo & Status Badge -->
                        <div class="flex items-start justify-between gap-4 mb-5">
                            <div class="flex items-center gap-3">
                                <div class="w-14 h-14 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/10 flex items-center justify-center p-2 shrink-0">
                                    @if (!string.IsNullOrWhiteSpace(brand.LogoPath))
                                    {
                                        <img src="@brand.LogoPath" alt="@displayName" class="max-h-full max-w-full object-contain" />
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-th-sky text-[28px]">domain</span>
                                    }
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <h3 class="font-poppins font-bold text-xl text-brand-navy dark:text-white">
                                            @displayName
                                        </h3>
                                        @if (!string.IsNullOrWhiteSpace(secondaryName))
                                        {
                                            <span class="text-sm text-slate-400 font-cairo">(@secondaryName)</span>
                                        }
                                    </div>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-slate-400 mt-1">
                                        /@brand.Slug
                                    </span>
                                </div>
                            </div>

                            <!-- Published Badge -->
                            @if (brand.IsPublished)
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shrink-0">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    @SharedLocalizer["CmsPublishedWord"]
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 shrink-0">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                    @SharedLocalizer["CmsDraft"]
                                </span>
                            }
                        </div>

                        <!-- Tagline -->
                        @if (!string.IsNullOrWhiteSpace(tagline))
                        {
                            <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4 line-clamp-2">
                                @tagline
                            </p>
                        }

                        <!-- Colors & Assets Badges -->
                        @if (!string.IsNullOrWhiteSpace(brand.PrimaryColor) || !string.IsNullOrWhiteSpace(brand.SecondaryColor) || !string.IsNullOrWhiteSpace(brand.AccentColor))
                        {
                            <div class="flex items-center gap-2 mb-3 px-3 py-2 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/5">
                                <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">@SharedLocalizer["CmsPalette"]</span>
                                <div class="flex items-center gap-1.5">
                                    @if (!string.IsNullOrWhiteSpace(brand.PrimaryColor))
                                    {
                                        <span class="w-4 h-4 rounded-full border border-black/10 shadow-sm" style="background-color: @brand.PrimaryColor" title="Primary: @brand.PrimaryColor"></span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(brand.SecondaryColor))
                                    {
                                        <span class="w-4 h-4 rounded-full border border-black/10 shadow-sm" style="background-color: @brand.SecondaryColor" title="Secondary: @brand.SecondaryColor"></span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(brand.AccentColor))
                                    {
                                        <span class="w-4 h-4 rounded-full border border-black/10 shadow-sm" style="background-color: @brand.AccentColor" title="Accent: @brand.AccentColor"></span>
                                    }
                                </div>
                                <div class="ms-auto flex items-center gap-2 text-[11px] text-slate-400">
                                    @if (!string.IsNullOrWhiteSpace(brand.FaviconPath))
                                    {
                                        <span class="inline-flex items-center gap-0.5" title="@SharedLocalizer["CmsFaviconConfigured"]"><span class="material-symbols-outlined text-[14px] text-emerald-500">check_circle</span> @SharedLocalizer["CmsFavicon"]</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(brand.LogoDarkPath))
                                    {
                                        <span class="inline-flex items-center gap-0.5" title="@SharedLocalizer["CmsDarkLogoConfigured"]"><span class="material-symbols-outlined text-[14px] text-purple-500">dark_mode</span> @SharedLocalizer["CmsDarkLogo"]</span>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Contact meta -->
                        <div class="space-y-2 text-xs text-slate-500 dark:text-slate-400 py-3 border-t border-slate-100 dark:border-white/5">
                            @if (!string.IsNullOrWhiteSpace(brand.Email))
                            {
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[16px] text-slate-400">mail</span>
                                    <span>@brand.Email</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(brand.Phone))
                            {
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[16px] text-slate-400">phone</span>
                                    <span>@brand.Phone</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(brand.Website))
                            {
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-[16px] text-slate-400">language</span>
                                    <a href="@brand.Website" target="_blank" class="text-th-sky hover:underline">@brand.Website</a>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Footer Actions -->
                    <div class="flex items-center justify-between pt-4 mt-4 border-t border-slate-100 dark:border-white/5">
                        <!-- Toggle Publish Form -->
                        <form asp-controller="CmsBrand" asp-action="TogglePublish" asp-route-id="@brand.Id" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-xs font-semibold @(brand.IsPublished ? "text-amber-600 hover:text-amber-700" : "text-emerald-600 hover:text-emerald-700") transition-colors flex items-center gap-1">
                                <span class="material-symbols-outlined text-[16px]">@(brand.IsPublished ? "visibility_off" : "visibility")</span>
                                <span>@(brand.IsPublished ? SharedLocalizer["CmsMoveToDraft"].Value : SharedLocalizer["CmsPublishLiveAction"].Value)</span>
                            </button>
                        </form>

                        <div class="flex items-center gap-2">
                            <a asp-controller="CmsBrand" asp-action="Edit" asp-route-id="@brand.Id"
                               class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-white/10 hover:bg-slate-50 dark:hover:bg-white/5 text-xs font-semibold text-slate-700 dark:text-slate-200 transition-colors">
                                <span class="material-symbols-outlined text-[16px]">edit</span>
                                <span>@SharedLocalizer["CmsEdit"]</span>
                            </a>

                            <form asp-controller="CmsBrand" asp-action="Delete" asp-route-id="@brand.Id" method="post"
                                  onsubmit="return confirm('Are you sure you want to remove the brand profile for @brand.NameEn?');" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors" title="@SharedLocalizer["CmsDeleteBrandProfile"]">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
