            <div>
                <h3 class="font-poppins font-bold text-lg text-brand-navy dark:text-white">@SharedLocalizer["CmsSocialChannels"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">@SharedLocalizer["CmsSocialChannelsDesc"]</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- LinkedIn -->
            <div class="space-y-1.5">
                <label asp-for="LinkedInUrl" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldLinkedInUrl"]
                </label>
                <input asp-for="LinkedInUrl" placeholder="https://linkedin.com/company/daleel"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="LinkedInUrl" class="text-xs text-red-500 block"></span>
            </div>

            <!-- Twitter / X -->
            <div class="space-y-1.5">
                <label asp-for="TwitterUrl" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldTwitterUrl"]
                </label>
                <input asp-for="TwitterUrl" placeholder="https://x.com/daleel_ai"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="TwitterUrl" class="text-xs text-red-500 block"></span>
            </div>

            <!-- Facebook -->
            <div class="space-y-1.5">
                <label asp-for="FacebookUrl" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFacebookUrlLabel"]
                </label>
                <input asp-for="FacebookUrl" placeholder="https://facebook.com/daleel"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="FacebookUrl" class="text-xs text-red-500 block"></span>
            </div>

            <!-- Instagram -->
            <div class="space-y-1.5">
                <label asp-for="InstagramUrl" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldInstagramUrl"]
                </label>
                <input asp-for="InstagramUrl" placeholder="https://instagram.com/daleel_ai"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="InstagramUrl" class="text-xs text-red-500 block"></span>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center justify-end gap-3 pt-4">
        <a asp-controller="CmsBrand" asp-action="Index"
           class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 font-medium text-sm transition-colors">
            @SharedLocalizer["CmsCancel"]
        </a>
        <button type="submit"
                class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#00B2EC] to-[#10B981] text-white font-semibold text-sm transition-all shadow-lg shadow-[#00B2EC]/20 hover:opacity-95 hover:scale-[1.02]">
            @SharedLocalizer["CmsSaveBrandProfile"]
        </button>
    </div>
</div>

<script>
    (function () {
        function bindColorPicker(pickerId, inputId) {
            const picker = document.getElementById(pickerId);
            const input = document.getElementById(inputId);
            if (!picker || !input) return;

            picker.addEventListener('input', function () {
                input.value = picker.value;
            });

            input.addEventListener('input', function () {
                if (/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(input.value.trim())) {
                    picker.value = input.value.trim();
                }
            });
        }

        bindColorPicker('primaryColorPicker', 'primaryColorInput');
        bindColorPicker('secondaryColorPicker', 'secondaryColorInput');
        bindColorPicker('accentColorPicker', 'accentColorInput');
    })();
</script>

