            </div>

            <!-- Office Address -->
            <div class="space-y-1.5">
                <label asp-for="Address" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsHeadquartersAddress"]
