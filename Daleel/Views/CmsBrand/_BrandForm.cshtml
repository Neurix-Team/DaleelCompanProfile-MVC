                <input asp-for="Address" placeholder="@SharedLocalizer["CmsEgAddress"]"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#F9A01B]" />
