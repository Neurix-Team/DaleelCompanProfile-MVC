@using System.Globalization
@model Daleel.BAL.Models.PagedResult<Daleel.BAL.Models.TeamMemberListItemDto>
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = SharedLocalizer["CmsTeamMembers"].Value;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var brands = ViewData["Brands"] as IReadOnlyList<Daleel.BAL.Models.BrandProfileListItemDto> ?? Array.Empty<Daleel.BAL.Models.BrandProfileListItemDto>();
    var currentBrandId = ViewData["CurrentBrandId"] as int?;
    var currentQ = ViewData["CurrentQ"]?.ToString();
    var currentIsPublished = ViewData["CurrentIsPublished"] as bool?;
}

<div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="font-poppins text-2xl font-bold text-brand-navy dark:text-white">
                @SharedLocalizer["CmsTeamMembers"]
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                @SharedLocalizer["CmsTeamIntro"]
            </p>
        </div>
        <a asp-controller="TeamMember" asp-action="Create" asp-route-brandId="@currentBrandId"
           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-th-sky to-[#10B981] text-white font-semibold text-sm transition-all shadow-lg shadow-th-sky/20 hover:opacity-95 hover:scale-[1.02] self-start sm:self-auto">
            <span class="material-symbols-outlined text-[20px]">person_add</span>
            <span>@SharedLocalizer["CmsAddMember"]</span>
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    <!-- Filters -->
    <form method="get" asp-controller="TeamMember" asp-action="Index"
          class="bg-th-card dark:bg-th-d-card p-4 rounded-2xl border border-slate-200/80 dark:border-white/10 shadow-sm flex flex-col md:flex-row items-center gap-3">

        <div class="w-full md:w-64">
            <select name="brandId"
                    class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-th-d-card text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky">
                <option value="">@SharedLocalizer["CmsAllBrands"]</option>
                @foreach (var b in brands)
                {
                    var bName = isRtl && !string.IsNullOrWhiteSpace(b.NameAr) ? $"{b.NameAr} ({b.NameEn})" : $"{b.NameEn} ({b.NameAr})";
                    <option value="@b.Id" selected="@(currentBrandId == b.Id ? "selected" : null)">@bName</option>
                }
            </select>
        </div>

        <div class="relative flex-1 w-full">
            <span class="material-symbols-outlined absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">search</span>
            <input type="text" name="q" value="@currentQ" placeholder="@SharedLocalizer["CmsSearchTeam"]"
                   class="w-full ps-10 pe-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
        </div>

        <div class="w-full md:w-44">
            <select name="isPublished"
                    class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-th-d-card text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky">
                <option value="">@SharedLocalizer["CmsAllStatuses"]</option>
                <option value="true" selected="@(currentIsPublished == true ? "selected" : null)">@SharedLocalizer["CmsPublishedOnly"]</option>
                <option value="false" selected="@(currentIsPublished == false ? "selected" : null)">@SharedLocalizer["CmsDraftsOnly"]</option>
            </select>
        </div>

        <div class="flex items-center gap-2 w-full md:w-auto">
            <button type="submit"
                    class="flex-1 md:flex-none px-4 py-2 rounded-xl bg-slate-900 dark:bg-white dark:text-slate-900 text-white font-medium text-sm hover:opacity-90 transition-all">
                @SharedLocalizer["CmsFilter"]
            </button>
            @if (currentBrandId.HasValue || !string.IsNullOrWhiteSpace(currentQ) || currentIsPublished.HasValue)
            {
                <a asp-controller="TeamMember" asp-action="Index"
                   class="p-2 rounded-xl border border-slate-200 dark:border-white/10 text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors" title="@SharedLocalizer["CmsClearFilters"]">
                    <span class="material-symbols-outlined text-[20px]">restart_alt</span>
                </a>
            }
        </div>
    </form>

    <!-- Team grid -->
    @if (Model.Items.Count == 0)
    {
        <div class="bg-th-card dark:bg-th-d-card p-12 text-center rounded-2xl border border-slate-200/80 dark:border-white/10">
            <div class="w-16 h-16 rounded-2xl bg-th-sky/10 text-th-sky flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-[32px]">group_off</span>
            </div>
            <h3 class="font-poppins font-bold text-lg text-slate-800 dark:text-slate-200">@SharedLocalizer["CmsNoTeamMembersFound"]</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-sm mx-auto">@SharedLocalizer["CmsNoTeamDesc"]</p>
            <a asp-controller="TeamMember" asp-action="Create" asp-route-brandId="@currentBrandId"
               class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-th-sky text-white text-sm font-semibold hover:opacity-90">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                <span>@SharedLocalizer["CmsAddMember"]</span>
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var m in Model.Items)
            {
                var displayName = isRtl && !string.IsNullOrWhiteSpace(m.NameAr) ? m.NameAr : m.NameEn;
                var secondaryName = isRtl ? m.NameEn : m.NameAr;
                var brandName = isRtl && !string.IsNullOrWhiteSpace(m.BrandNameAr) ? m.BrandNameAr : m.BrandNameEn;
                var title = isRtl && !string.IsNullOrWhiteSpace(m.TitleAr) ? m.TitleAr : m.TitleEn;

                <div class="bg-th-card dark:bg-th-d-card rounded-2xl border border-slate-200/80 dark:border-white/10 overflow-hidden shadow-sm hover:border-th-sky/40 transition-all group flex flex-col">
                    <!-- Photo / Avatar -->
                    <div class="relative pt-8 pb-4 px-6 flex flex-col items-center bg-gradient-to-b from-slate-50 to-white dark:from-white/[0.03] dark:to-th-d-card">
                        @if (!string.IsNullOrWhiteSpace(m.PhotoPath))
                        {
                            <img src="@m.PhotoPath" alt="@displayName"
                                 class="w-24 h-24 rounded-full object-cover border-4 border-white dark:border-th-d-card shadow-lg group-hover:scale-105 transition-transform" />
                        }
                        else
                        {
                            <div class="w-24 h-24 rounded-full bg-th-sky/10 flex items-center justify-center border-4 border-white dark:border-th-d-card shadow-lg">
                                <span class="material-symbols-outlined text-[36px] text-th-sky">person</span>
                            </div>
                        }

                        <!-- Status badge -->
                        <div class="absolute top-3 end-3">
                            @if (m.IsPublished)
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>@SharedLocalizer["CmsLive"]
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>@SharedLocalizer["CmsDraft"]
                                </span>
                            }
                        </div>

                        <!-- Brand badge -->
                        <span class="absolute top-3 start-3 text-[10px] font-bold uppercase tracking-wider text-slate-400">@brandName</span>
                    </div>

                    <!-- Info -->
                    <div class="px-6 pb-4 text-center flex-1">
                        <h3 class="font-poppins font-bold text-base text-brand-navy dark:text-white group-hover:text-th-sky transition-colors">
                            @displayName
                        </h3>
                        @if (!string.IsNullOrWhiteSpace(secondaryName))
                        {
                            <p class="text-xs text-slate-400 @(isRtl ? "font-sans" : "font-cairo") mb-1" dir="@(isRtl ? "ltr" : "rtl")">@secondaryName</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(title))
                        {
                            <p class="text-xs font-semibold text-th-sky mt-2">@title</p>
                        }

                        <!-- Contact links -->
                        <div class="flex items-center justify-center gap-3 mt-3">
                            @if (!string.IsNullOrWhiteSpace(m.Email))
                            {
                                <a href="mailto:@m.Email" class="text-slate-400 hover:text-th-sky transition-colors" title="@m.Email">
                                    <span class="material-symbols-outlined text-[18px]">email</span>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.LinkedInUrl))
                            {
                                <a href="@m.LinkedInUrl" target="_blank" class="text-slate-400 hover:text-[#0077B5] transition-colors" title="@SharedLocalizer["CmsLinkedIn"]">
                                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Footer Actions -->
                    <div class="px-4 py-3 bg-slate-50/50 dark:bg-white/[0.02] border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
                        <span class="text-[11px] font-mono text-slate-400">#@m.DisplayOrder</span>

                        <div class="flex items-center gap-1.5">
                            <form asp-controller="TeamMember" asp-action="TogglePublish" asp-route-id="@m.Id" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/10 transition-colors"
                                        title="@(m.IsPublished ? SharedLocalizer["CmsUnpublish"].Value : SharedLocalizer["CmsPublish"].Value)">
                                    <span class="material-symbols-outlined text-[18px]">@(m.IsPublished ? "visibility_off" : "visibility")</span>
                                </button>
                            </form>

                            <a asp-controller="TeamMember" asp-action="Edit" asp-route-id="@m.Id"
                               class="p-1.5 rounded-lg text-slate-400 hover:text-th-sky hover:bg-th-sky/10 transition-colors" title="@SharedLocalizer["CmsEdit"]">
                                <span class="material-symbols-outlined text-[18px]">edit</span>
                            </a>

                            <form asp-controller="TeamMember" asp-action="Delete" asp-route-id="@m.Id" method="post"
                                  onsubmit="return confirm('Remove this team member?');" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors" title="@SharedLocalizer["CmsDelete"]">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex items-center justify-between pt-4">
                <p class="text-xs text-slate-500">
                    @SharedLocalizer["CmsShowingMembers", (Model.Page - 1) * Model.PageSize + 1, Math.Min(Model.Page * Model.PageSize, Model.TotalCount), Model.TotalCount]
                </p>

                <div class="flex items-center gap-1">
                    @if (Model.HasPrevious)
                    {
                        <a asp-controller="TeamMember" asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-brandId="@currentBrandId"
                           asp-route-q="@currentQ"
                           asp-route-isPublished="@currentIsPublished"
                           class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-white/10 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5">
                            @SharedLocalizer["CmsPrevious"]
                        </a>
                    }
                    @if (Model.HasNext)
                    {
                        <a asp-controller="TeamMember" asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-brandId="@currentBrandId"
                           asp-route-q="@currentQ"
                           asp-route-isPublished="@currentIsPublished"
                           class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-white/10 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5">
                            @SharedLocalizer["CmsNext"]
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>
