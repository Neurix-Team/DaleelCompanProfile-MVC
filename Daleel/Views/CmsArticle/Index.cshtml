@model Daleel.BAL.Models.PagedResult<Daleel.BAL.Models.ArticleListItem>
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = SharedLocalizer["CmsTitleArticlesManagement"].Value;
    var currentQ = ViewData["Q"]?.ToString();
    var currentCategory = ViewData["Category"]?.ToString();
    var currentIsPublished = ViewData["IsPublished"] as bool?;
}

<div class="space-y-6">

    <!-- Header & Action Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="font-poppins text-2xl font-bold text-brand-navy dark:text-white">
                @SharedLocalizer["CmsArticlesBlog"]
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                @SharedLocalizer["CmsArticlesMgmtDesc"]
            </p>
        </div>
        <a asp-controller="CmsArticle" asp-action="Create"
           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-th-sky to-[#10B981] text-white font-semibold text-sm transition-all shadow-lg shadow-th-sky/20 hover:opacity-95 hover:scale-[1.02] self-start sm:self-auto">
            <span class="material-symbols-outlined text-[20px]">add</span>
            <span>@SharedLocalizer["CmsNewArticle"]</span>
        </a>
    </div>

    <!-- Filters & Search Bar -->
    <form method="get" asp-controller="CmsArticle" asp-action="Index"
          class="bg-th-card dark:bg-th-d-card p-4 rounded-2xl border border-slate-200/80 dark:border-white/10 shadow-sm flex flex-col md:flex-row items-center gap-3">
        
        <!-- Search Input -->
        <div class="relative flex-1 w-full">
            <span class="material-symbols-outlined absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">search</span>
            <input type="text" name="q" value="@currentQ" placeholder="@SharedLocalizer["CmsSearchArticles"]"
                   class="w-full ps-10 pe-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
        </div>

        <!-- Status Filter -->
        <div class="w-full md:w-48">
            <select name="isPublished"
                    class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky">
                <option value="">@SharedLocalizer["CmsAllStatuses"]</option>
                <option value="true" selected="@(currentIsPublished == true ? "selected" : null)">@SharedLocalizer["CmsPublishedOnly"]</option>
                <option value="false" selected="@(currentIsPublished == false ? "selected" : null)">@SharedLocalizer["CmsDraftsOnly"]</option>
            </select>
        </div>

        <!-- Filter Submit & Reset -->
        <div class="flex items-center gap-2 w-full md:w-auto">
            <button type="submit"
                    class="flex-1 md:flex-none px-4 py-2 rounded-xl bg-slate-900 dark:bg-white dark:text-slate-900 text-white font-medium text-sm hover:opacity-90 transition-all">
                @SharedLocalizer["CmsFilter"]
            </button>
            @if (!string.IsNullOrWhiteSpace(currentQ) || currentIsPublished.HasValue)
            {
                <a asp-controller="CmsArticle" asp-action="Index"
                   class="p-2 rounded-xl border border-slate-200 dark:border-white/10 text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors" title="@SharedLocalizer["CmsClearFilters"]">
                    <span class="material-symbols-outlined text-[20px]">restart_alt</span>
                </a>
            }
        </div>
    </form>

    <!-- Articles Table Card -->
    <div class="bg-th-card dark:bg-th-d-card border border-slate-200/80 dark:border-white/10 rounded-2xl shadow-sm overflow-hidden">
        @if (Model.Items.Count == 0)
        {
            <div class="p-12 text-center">
                <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-white/5 text-slate-400 flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-[32px]">search_off</span>
                </div>
                <h4 class="font-poppins font-semibold text-base text-slate-800 dark:text-slate-200">@SharedLocalizer["CmsNoArticlesMatch"]</h4>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@SharedLocalizer["CmsNoArticlesMatchDesc"]</p>
                <a asp-controller="CmsArticle" asp-action="Create"
                   class="inline-flex items-center gap-2 mt-4 px-4 py-2 rounded-xl bg-th-sky text-white font-medium text-sm">
                    <span class="material-symbols-outlined text-[18px]">add</span>
                    <span>@SharedLocalizer["CmsCreateArticle"]</span>
                </a>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-start text-sm">
                    <thead class="bg-slate-50 dark:bg-white/[0.02] text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 border-b border-slate-100 dark:border-white/5">
                        <tr>
                            <th class="px-6 py-4 text-start">@SharedLocalizer["CmsArticleTitle"]</th>
                            <th class="px-6 py-4 text-start">@SharedLocalizer["CmsCategory"]</th>
                            <th class="px-6 py-4 text-start">@SharedLocalizer["CmsAuthor"]</th>
                            <th class="px-6 py-4 text-start">@SharedLocalizer["CmsStatus"]</th>
                            <th class="px-6 py-4 text-start">@SharedLocalizer["CmsDate"]</th>
                            <th class="px-6 py-4 text-end">@SharedLocalizer["CmsActions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                        @foreach (var article in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/70 dark:hover:bg-white/[0.02] transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3.5">
                                        @if (!string.IsNullOrWhiteSpace(article.CoverImagePath))
                                        {
                                            <img src="@article.CoverImagePath" alt="" class="w-14 h-14 rounded-xl object-cover shrink-0 border border-slate-200 dark:border-white/10 shadow-sm" />
                                        }
                                        else
                                        {
                                            <div class="w-14 h-14 rounded-xl bg-slate-100 dark:bg-white/5 flex items-center justify-center shrink-0 text-slate-400 border border-slate-200/50 dark:border-white/5">
                                                <span class="material-symbols-outlined text-[24px]">image</span>
                                            </div>
                                        }
                                        <div class="min-w-0 max-w-md">
                                            <a asp-controller="CmsArticle" asp-action="Edit" asp-route-id="@article.Id"
                                               class="font-semibold text-slate-900 dark:text-white hover:text-th-sky dark:hover:text-th-sky transition-colors line-clamp-1 block text-base">
                                                @article.TitleEn
                                            </a>
                                            <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1 font-cairo" dir="rtl">@article.TitleAr</p>
                                            <div class="flex items-center gap-2 mt-1 text-[11px] text-slate-400 flex-wrap">
                                                <span class="font-mono">/@article.Slug</span>
                                                <span>·</span>
                                                <span>@article.ReadingMinutes @SharedLocalizer["CmsMinRead"]</span>
                                                @if (!string.IsNullOrWhiteSpace(article.Tags))
                                                {
                                                    <span>·</span>
                                                    @foreach (var tag in article.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(3))
                                                    {
                                                        <span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-white/5 text-[10px] text-slate-500">#@tag</span>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-white/10 text-slate-700 dark:text-slate-300">
                                        @(string.IsNullOrWhiteSpace(article.Category) ? "General" : article.Category)
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-xs font-medium text-slate-700 dark:text-slate-300">
                                    @article.AuthorName
                                </td>
                                <td class="px-6 py-4">
                                    <form asp-controller="CmsArticle" asp-action="TogglePublish" asp-route-id="@article.Id" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        @if (article.IsScheduled)
                                        {
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-600 dark:text-sky-400 hover:bg-sky-500/20 transition-all"
                                                    title="Scheduled for @article.ScheduledPublishAt?.ToString("g") UTC. Click to unpublish.">
                                                <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span>
                                                @SharedLocalizer["CmsScheduled"]
                                            </button>
                                        }
                                        else if (article.IsPublished)
                                        {
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/20 transition-all"
                                                    title="@SharedLocalizer["CmsClickToUnpublish"]">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                                @SharedLocalizer["CmsPublishedWord"]
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 hover:bg-amber-500/20 transition-all"
                                                    title="@SharedLocalizer["CmsClickToPublish"]">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                                @SharedLocalizer["CmsDraft"]
                                            </button>
                                        }
                                    </form>
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-500 dark:text-slate-400">
                                    @if (article.IsScheduled)
                                    {
                                        <span class="text-sky-600 dark:text-sky-400 font-medium">
                                            @article.ScheduledPublishAt?.ToString("MMM dd, yyyy HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        @(article.PublishedAt?.ToString("MMM dd, yyyy") ?? article.CreatedAt.ToString("MMM dd, yyyy"))
                                    }
                                </td>
                                <td class="px-6 py-4 text-end">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-controller="Home" asp-action="Article" asp-route-slug="@article.Slug" target="_blank"
                                           class="p-2 rounded-xl text-slate-400 hover:text-th-sky hover:bg-th-sky/10 transition-colors" title="@SharedLocalizer["CmsViewLive"]">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </a>
                                        <a asp-controller="CmsArticle" asp-action="Edit" asp-route-id="@article.Id"
                                           class="p-2 rounded-xl text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/10 transition-colors" title="@SharedLocalizer["CmsEdit"]">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>
                                        <form asp-controller="CmsArticle" asp-action="Delete" asp-route-id="@article.Id" method="post" class="inline"
                                              onsubmit="return confirm('Are you sure you want to delete this article?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="p-2 rounded-xl text-slate-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors" title="@SharedLocalizer["CmsDelete"]">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Pager -->
    @if (Model.TotalPages > 1)
    {
        @await Html.PartialAsync("_Pager", new Daleel.Models.PagerViewModel
        {
            Page = Model.Page,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount
        })
    }
</div>
