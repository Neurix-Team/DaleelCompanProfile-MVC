@model Daleel.Models.ArticleFormViewModel

<div class="space-y-8">
    <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 text-sm"></div>

    <!-- Hidden Fields -->
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingCoverImagePath" />
    <input type="hidden" asp-for="BodyHtmlEn" id="inputBodyEn" />
    <input type="hidden" asp-for="BodyHtmlAr" id="inputBodyAr" />

    <!-- Language Tabs Selector -->
    <div class="flex border-b border-slate-200 dark:border-white/10 gap-8">
        <button type="button" id="tab-btn-en" onclick="switchLanguageTab('en')"
                class="pb-3 text-sm font-semibold border-b-2 border-th-sky text-th-sky flex items-center gap-2 transition-all">
            <span class="material-symbols-outlined text-[18px]">translate</span>
            <span>@SharedLocalizer["CmsEnglishContent"]</span>
        </button>
        <button type="button" id="tab-btn-ar" onclick="switchLanguageTab('ar')"
                class="pb-3 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center gap-2 transition-all">
            <span class="material-symbols-outlined text-[18px]">language</span>
            <span>المحتوى العربي (Arabic)</span>
        </button>
    </div>

    <!-- English Tab Pane -->
    <div id="tab-pane-en" class="space-y-6">
        <!-- Title EN -->
        <div>
            <label asp-for="TitleEn" class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">
                @SharedLocalizer["CmsArticleTitleEnLabel"] <span class="text-red-500">*</span>
            </label>
            <input asp-for="TitleEn" id="titleEnInput" placeholder="@SharedLocalizer["CmsEgArticleTitle"]"
                   class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-slate-900 dark:text-white text-base focus:outline-none focus:ring-2 focus:ring-th-sky" />
            <span asp-validation-for="TitleEn" class="text-xs text-red-500 mt-1 block"></span>
        </div>

        <!-- Summary EN -->
        <div>
            <label asp-for="SummaryEn" class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">
                @SharedLocalizer["CmsShortSummaryLeadEn"]
            </label>
            <textarea asp-for="SummaryEn" rows="3" placeholder="@SharedLocalizer["CmsSummaryPlaceholder"]"
                      class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-th-sky"></textarea>
            <span asp-validation-for="SummaryEn" class="text-xs text-red-500 mt-1 block"></span>
        </div>

        <!-- Body EN (Quill) -->
        <div>
            <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">
                <span class="text-red-500">*</span>
                @SharedLocalizer["CmsArticleBodyEn"]
            </label>
            <div id="quill-editor-en" class="bg-th-card dark:bg-th-d-raised/50">
                @Html.Raw(Model.BodyHtmlEn)
            </div>
            <span asp-validation-for="BodyHtmlEn" class="text-xs text-red-500 mt-1 block"></span>
        </div>
    </div>

    <!-- Arabic Tab Pane -->
    <div id="tab-pane-ar" class="space-y-6 hidden" dir="rtl">
        <!-- Title AR -->
        <div>
            <label asp-for="TitleAr" class="block text-sm font-semibold text-slate-900 dark:text-white mb-2 font-cairo">
                عنوان المقال (باللغة العربية) <span class="text-red-500">*</span>
            </label>
            <input asp-for="TitleAr" placeholder="مثال: تسريع تبني الذكاء الاصطناعي المؤسسي في المملكة"
                   class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-slate-900 dark:text-white text-base focus:outline-none focus:ring-2 focus:ring-th-sky font-cairo" />
            <span asp-validation-for="TitleAr" class="text-xs text-red-500 mt-1 block"></span>
        </div>

        <!-- Summary AR -->
        <div>
            <label asp-for="SummaryAr" class="block text-sm font-semibold text-slate-900 dark:text-white mb-2 font-cairo">
                الملخص / المقدمة (باللغة العربية)
            </label>
            <textarea asp-for="SummaryAr" rows="3" placeholder="مقدمة مختصرة تظهر في بطاقة المقال ومحركات البحث..."
                      class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-th-sky font-cairo"></textarea>
            <span asp-validation-for="SummaryAr" class="text-xs text-red-500 mt-1 block"></span>
        </div>

        <!-- Body AR (Quill) -->
        <div>
            <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2 font-cairo">
                <span class="text-red-500">*</span>
                محتوى المقال (باللغة العربية)
            </label>
            <div id="quill-editor-ar" class="bg-th-card dark:bg-th-d-raised/50 text-right font-cairo">
                @Html.Raw(Model.BodyHtmlAr)
            </div>
            <span asp-validation-for="BodyHtmlAr" class="text-xs text-red-500 mt-1 block"></span>
        </div>
    </div>

    <!-- Publishing Meta & Media Grid -->
    <div class="pt-8 border-t border-slate-200 dark:border-white/10 grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Left Column: Slug & Category & Author -->
        <div class="space-y-5">
            <div>
                <label asp-for="Slug" class="block text-sm font-semibold text-slate-900 dark:text-white mb-1.5">
                    @SharedLocalizer["CmsUrlSlug"]
                </label>
                <div class="flex rounded-xl border border-slate-200 dark:border-white/10 overflow-hidden bg-slate-50/50 dark:bg-white/5 focus-within:ring-2 focus-within:ring-th-sky">
                    <span class="px-3.5 py-2.5 bg-slate-100 dark:bg-white/5 text-slate-500 text-xs font-mono flex items-center border-e border-slate-200 dark:border-white/10">
                        /article/
                    </span>
                    <input asp-for="Slug" placeholder="auto-generated-from-title"
                           class="flex-1 px-3.5 py-2.5 bg-transparent text-sm text-slate-900 dark:text-white focus:outline-none font-mono" />
                </div>
                <p class="text-[11px] text-slate-400 mt-1">@SharedLocalizer["CmsSlugAutoHint"]</p>
                <span asp-validation-for="Slug" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Category" class="block text-sm font-semibold text-slate-900 dark:text-white mb-1.5">
                        @SharedLocalizer["CmsCategory"]
                    </label>
                    <input asp-for="Category" placeholder="@SharedLocalizer["CmsEgCategory"]"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
                </div>

                <div>
                    <label asp-for="ReadingMinutes" class="block text-sm font-semibold text-slate-900 dark:text-white mb-1.5">
                        @SharedLocalizer["CmsReadingTimeMin"]
                    </label>
                    <input asp-for="ReadingMinutes" type="number" min="1" max="120"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
                </div>
            </div>

            <div>
                <label asp-for="Tags" class="block text-sm font-semibold text-slate-900 dark:text-white mb-1.5">
                    @SharedLocalizer["CmsTags"]
                </label>
                <input asp-for="Tags" placeholder="@SharedLocalizer["CmsEgTags"]"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
                <p class="text-[11px] text-slate-400 mt-1">@SharedLocalizer["CmsTagsHint"]</p>
                <span asp-validation-for="Tags" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="AuthorName" class="block text-sm font-semibold text-slate-900 dark:text-white mb-1.5">
                    @SharedLocalizer["CmsAuthorName"]
                </label>
                <input asp-for="AuthorName"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
            </div>

            <!-- Publish Checkbox & Scheduling -->
            <div class="space-y-3 p-4 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-200/80 dark:border-white/10">
                <div class="flex items-center justify-between">
                    <div>
                        <label asp-for="IsPublished" class="text-sm font-semibold text-slate-900 dark:text-white cursor-pointer block">
                            @SharedLocalizer["CmsPublishedStatus"]
                        </label>
                        <span class="text-xs text-slate-500 dark:text-slate-400">@SharedLocalizer["CmsScheduledHint"]</span>
                    </div>
                    <input asp-for="IsPublished" type="checkbox"
                           class="w-5 h-5 rounded text-th-sky focus:ring-th-sky cursor-pointer" />
                </div>
                <div class="pt-3 border-t border-slate-200/60 dark:border-white/5">
                    <label asp-for="ScheduledPublishAt" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        @SharedLocalizer["CmsScheduledPubUtc"]
                    </label>
                    <input asp-for="ScheduledPublishAt" type="datetime-local"
                           class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
                    <p class="text-[10px] text-slate-400 mt-1">@SharedLocalizer["CmsScheduleEmptyHint"]</p>
                </div>
            </div>
        </div>

        <!-- Right Column: Cover Image Upload -->
        <div class="space-y-4">
            <label class="block text-sm font-semibold text-slate-900 dark:text-white">
                @SharedLocalizer["CmsCoverImageLabel"]
            </label>

            @if (!string.IsNullOrWhiteSpace(Model.ExistingCoverImagePath))
            {
                <div class="relative rounded-2xl overflow-hidden border border-slate-200 dark:border-white/10 group h-48 bg-slate-900">
                    <img id="coverPreview" src="@Model.ExistingCoverImagePath" alt="@SharedLocalizer["CmsCover"]" class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-semibold">
                        @SharedLocalizer["CmsChangeImageBelow"]
                    </div>
                </div>
            }
            else
            {
                <div id="previewPlaceholder" class="h-48 rounded-2xl border-2 border-dashed border-slate-200 dark:border-white/15 flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 bg-slate-50/50 dark:bg-white/[0.02]">
                    <span class="material-symbols-outlined text-[36px] text-slate-300 dark:text-slate-600 mb-2">add_photo_alternate</span>
                    <span class="text-xs">@SharedLocalizer["CmsNoCoverImage"]</span>
                </div>
            }

            <div>
                <input asp-for="CoverImage" type="file" accept="image/*" id="coverImageInput"
                       class="block w-full text-xs text-slate-500 file:me-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-th-sky/10 file:text-th-sky hover:file:bg-th-sky/20 cursor-pointer" />
                <p class="text-[11px] text-slate-400 mt-1">@SharedLocalizer["CmsSupportedFormats"]</p>
            </div>
        </div>
    </div>

    <!-- SEO & Metadata Card (Collapsible) -->
    <div class="p-6 rounded-2xl border border-slate-200/80 dark:border-white/10 bg-slate-50/50 dark:bg-white/[0.02] space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-th-sky text-[22px]">travel_explore</span>
                <h3 class="font-semibold text-base text-slate-900 dark:text-white">@SharedLocalizer["CmsSeoSocialSharing"]</h3>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-full bg-th-sky/10 text-th-sky font-medium">@SharedLocalizer["CmsOptional"]</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400">
            @SharedLocalizer["CmsSeoHelpText"]
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <!-- SEO English -->
            <div class="space-y-3 p-4 rounded-xl bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500">@SharedLocalizer["CmsEnglishSeoMeta"]</h4>
                <div>
                    <label asp-for="MetaTitleEn" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        @SharedLocalizer["CmsMetaTitleEnShort"]
                    </label>
                    <input asp-for="MetaTitleEn" placeholder="@SharedLocalizer["CmsMetaTitlePlaceholder"]"
                           class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-transparent text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
                </div>
                <div>
                    <label asp-for="MetaDescriptionEn" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        @SharedLocalizer["CmsMetaDescEnShort"]
                    </label>
                    <textarea asp-for="MetaDescriptionEn" rows="2" placeholder="@SharedLocalizer["CmsMetaDescPlaceholder"]"
                              class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-transparent text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky"></textarea>
                </div>
            </div>

            <!-- SEO Arabic -->
            <div class="space-y-3 p-4 rounded-xl bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10" dir="rtl">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 font-cairo">بيانات محركات البحث (بالعربية)</h4>
                <div>
                    <label asp-for="MetaTitleAr" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1 font-cairo">
                        عنوان السيو (AR)
                    </label>
                    <input asp-for="MetaTitleAr" placeholder="عنوان المقال المخصص لمحركات البحث..."
                           class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-transparent text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky font-cairo" />
                </div>
                <div>
                    <label asp-for="MetaDescriptionAr" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1 font-cairo">
                        وصف السيو (AR)
                    </label>
                    <textarea asp-for="MetaDescriptionAr" rows="2" placeholder="الوصف الظاهر في نتائج البحث ومواقع التواصل..."
                              class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-transparent text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky font-cairo"></textarea>
                </div>
            </div>
        </div>

        <div>
            <label asp-for="CanonicalUrl" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                @SharedLocalizer["CmsCanonicalUrlOptional"]
            </label>
            <input asp-for="CanonicalUrl" placeholder="https://daleel.sa/article/original-source (leave blank for default)"
                   class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 text-xs text-slate-900 dark:text-white font-mono focus:outline-none focus:ring-2 focus:ring-th-sky" />
        </div>
    </div>

    <!-- Form Submit Actions -->
    <div class="pt-6 border-t border-slate-200 dark:border-white/10 flex items-center justify-between">
        <a asp-controller="CmsArticle" asp-action="Index"
           class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 font-medium text-sm transition-colors">
            @SharedLocalizer["CmsCancel"]
        </a>
        <button type="submit" id="saveArticleBtn"
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-gradient-to-r from-th-sky to-[#10B981] text-white font-semibold text-sm transition-all shadow-lg shadow-th-sky/20 hover:opacity-95 hover:scale-[1.02]">
            <span class="material-symbols-outlined text-[20px]">save</span>
            <span>@(Model.Id > 0 ? SharedLocalizer["CmsSaveChanges"].Value : SharedLocalizer["CmsCreateArticle"].Value)</span>
        </button>
    </div>
</div>

<script>
    function switchLanguageTab(lang) {
        var tabEn = document.getElementById('tab-btn-en');
        var tabAr = document.getElementById('tab-btn-ar');
        var paneEn = document.getElementById('tab-pane-en');
        var paneAr = document.getElementById('tab-pane-ar');

        if (lang === 'en') {
            tabEn.classList.add('border-th-sky', 'text-th-sky');
            tabEn.classList.remove('border-transparent', 'text-slate-500');
            tabAr.classList.remove('border-th-sky', 'text-th-sky');
            tabAr.classList.add('border-transparent', 'text-slate-500');
            paneEn.classList.remove('hidden');
            paneAr.classList.add('hidden');
        } else {
            tabAr.classList.add('border-th-sky', 'text-th-sky');
            tabAr.classList.remove('border-transparent', 'text-slate-500');
            tabEn.classList.remove('border-th-sky', 'text-th-sky');
            tabEn.classList.add('border-transparent', 'text-slate-500');
            paneAr.classList.remove('hidden');
            paneEn.classList.add('hidden');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var toolbarOptions = [
            [{ 'header': [1, 2, 3, false] }],
            ['bold', 'italic', 'underline', 'strike'],
            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
            [{ 'align': [] }, { 'direction': 'rtl' }],
            ['link', 'blockquote', 'code-block'],
            ['clean']
        ];

        var quillEn = new Quill('#quill-editor-en', {
            theme: 'snow',
            modules: { toolbar: toolbarOptions },
            placeholder: 'Write article content in English...'
        });

        var quillAr = new Quill('#quill-editor-ar', {
            theme: 'snow',
            modules: { toolbar: toolbarOptions },
            placeholder: 'اكتب محتوى المقال باللغة العربية...'
        });

        // Sync Quill HTML content to hidden inputs on submit
        var form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function () {
                document.getElementById('inputBodyEn').value = quillEn.root.innerHTML;
                document.getElementById('inputBodyAr').value = quillAr.root.innerHTML;
            });
        }

        // Live image preview
        var imageInput = document.getElementById('coverImageInput');
        if (imageInput) {
            imageInput.addEventListener('change', function (e) {
                if (e.target.files && e.target.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (evt) {
                        var existing = document.getElementById('coverPreview');
                        if (existing) {
                            existing.src = evt.target.result;
                        } else {
                            var placeholder = document.getElementById('previewPlaceholder');
                            if (placeholder) {
                                placeholder.innerHTML = '';
                                var img = document.createElement('img');
                                img.src = evt.target.result;
                                img.alt = 'Cover preview';
                                img.className = 'w-full h-full object-cover rounded-2xl';
                                placeholder.appendChild(img);
                            }
                        }
                    };
                    reader.readAsDataURL(e.target.files[0]);
                }
            });
        }
    });
</script>
