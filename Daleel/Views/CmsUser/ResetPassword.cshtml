@model Daleel.Models.ResetUserPasswordViewModel
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = $"Reset Password for {Model.FullName}";
}

<div class="max-w-md mx-auto space-y-6">

    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-controller="CmsUser" asp-action="Index"
           class="p-2 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-white/5 text-slate-500 transition-colors">
            <span class="material-symbols-outlined text-[20px] rtl:rotate-180">arrow_back</span>
        </a>
        <div>
            <h2 class="font-poppins text-2xl font-bold text-brand-navy dark:text-white">@SharedLocalizer["CmsResetPassword"]</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">@SharedLocalizer["CmsSetNewPasswordFor"] @Model.FullName</p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-[#0B1728] p-6 sm:p-8 rounded-3xl border border-slate-200/80 dark:border-white/10 shadow-sm space-y-6">
        
        <div class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-700 dark:text-amber-300 flex items-start gap-2.5">
            <span class="material-symbols-outlined text-[20px] text-amber-500 shrink-0">info</span>
            <div>
                <strong>@SharedLocalizer["CmsUserLabel"]</strong> @Model.FullName<br />
                <strong>@SharedLocalizer["CmsEmailLabel"]</strong> @Model.Email
            </div>
        </div>

        <form method="post" asp-controller="CmsUser" asp-action="ResetPassword" asp-route-id="@Model.UserId" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="FullName" />

            <div asp-validation-summary="All" class="text-xs text-red-500 bg-red-50 dark:bg-red-500/10 p-3.5 rounded-xl border border-red-200 dark:border-red-500/20 hidden:empty"></div>

            <div>
                <label asp-for="NewPassword" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsNewPassword"]</label>
                <input asp-for="NewPassword" type="password" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="NewPassword" class="text-[11px] text-red-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsConfirmNewPassword"]</label>
                <input asp-for="ConfirmPassword" type="password" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="ConfirmPassword" class="text-[11px] text-red-500 mt-1 block"></span>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-white/10">
                <a asp-controller="CmsUser" asp-action="Index"
                   class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
                    @SharedLocalizer["CmsCancel"]
                </a>
                <button type="submit"
                        class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-semibold text-xs transition-all shadow-md shadow-amber-500/20">
                    @SharedLocalizer["CmsUpdatePassword"]
                </button>
            </div>
        </form>
    </div>
</div>
