@model Daleel.Models.CreateCmsUserViewModel
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = SharedLocalizer["CmsCreateNewCmsUser"].Value;
}

<div class="max-w-2xl mx-auto space-y-6">

    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-controller="CmsUser" asp-action="Index"
           class="p-2 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-white/5 text-slate-500 transition-colors">
            <span class="material-symbols-outlined text-[20px] rtl:rotate-180">arrow_back</span>
        </a>
        <div>
            <h2 class="font-poppins text-2xl font-bold text-brand-navy dark:text-white">@SharedLocalizer["CmsCreateNewCmsUser"]</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">@SharedLocalizer["CmsCreateUserDesc"]</p>
        </div>
    </div>

    <!-- Card Form -->
    <div class="bg-white dark:bg-[#0B1728] p-6 sm:p-8 rounded-3xl border border-slate-200/80 dark:border-white/10 shadow-sm space-y-6">
        <form method="post" asp-controller="CmsUser" asp-action="Create" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-xs text-red-500 bg-red-50 dark:bg-red-500/10 p-3.5 rounded-xl border border-red-200 dark:border-red-500/20 hidden:empty"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="FirstName" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsFirstName"]</label>
                    <input asp-for="FirstName" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                    <span asp-validation-for="FirstName" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsLastName"]</label>
                    <input asp-for="LastName" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                    <span asp-validation-for="LastName" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsWorkEmail"]</label>
                <input asp-for="Email" type="email" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="Email" class="text-[11px] text-red-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Role" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsAccessRole"]</label>
                <select asp-for="Role" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]">
                    <option value="Admin">@SharedLocalizer["CmsRoleAdminFull"]</option>
                    <option value="Staff">@SharedLocalizer["CmsRoleStaff"]</option>
                </select>
                <span asp-validation-for="Role" class="text-[11px] text-red-500 mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Password" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsInitialPassword"]</label>
                    <input asp-for="Password" type="password" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                    <span asp-validation-for="Password" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsConfirmPassword"]</label>
                    <input asp-for="ConfirmPassword" type="password" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                    <span asp-validation-for="ConfirmPassword" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded text-[#00B2EC] focus:ring-[#00B2EC] border-slate-300 dark:border-white/10" />
                <label asp-for="IsActive" class="text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">@SharedLocalizer["CmsAccountActiveLogin"]</label>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-white/10">
                <a asp-controller="CmsUser" asp-action="Index"
                   class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
                    @SharedLocalizer["CmsCancel"]
                </a>
                <button type="submit"
                        class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#00B2EC] to-[#10B981] text-white font-semibold text-xs transition-all shadow-md shadow-[#00B2EC]/20 hover:opacity-95">
                    @SharedLocalizer["CmsCreateUser"]
                </button>
            </div>
        </form>
    </div>
</div>
