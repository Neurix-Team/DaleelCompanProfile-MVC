@model IReadOnlyList<Daleel.Models.CmsUserListItemViewModel>
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = SharedLocalizer["CmsTitleUserAccessManagement"].Value;
}

<div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="font-poppins text-2xl sm:text-3xl font-bold text-brand-navy dark:text-white">
                @SharedLocalizer["CmsAdminsAndUsers"]
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                @SharedLocalizer["CmsUsersIntro"]
            </p>
        </div>
        <a asp-controller="CmsUser" asp-action="Create"
           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#00B2EC] to-[#10B981] text-white font-semibold text-sm transition-all shadow-lg shadow-[#00B2EC]/20 hover:opacity-95 hover:scale-[1.02]">
            <span class="material-symbols-outlined text-[20px]">person_add</span>
            <span>@SharedLocalizer["CmsCreateNewUser"]</span>
        </a>
    </div>

    <!-- Users Table Card -->
    <div class="bg-white dark:bg-[#0B1728] rounded-2xl border border-slate-200/80 dark:border-white/10 shadow-sm overflow-hidden">
        @if (Model.Count == 0)
        {
            <div class="p-12 text-center text-slate-500">
                @SharedLocalizer["CmsNoUsersFound"]
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-start text-sm text-slate-600 dark:text-slate-300">
                    <thead class="bg-slate-50/80 dark:bg-white/[0.02] text-xs uppercase font-semibold text-slate-500 dark:text-slate-400 border-b border-slate-200/80 dark:border-white/10">
                        <tr>
                            <th class="px-6 py-4 text-start">@SharedLocalizer["CmsUser"]</th>
                            <th class="px-6 py-4 text-start">@SharedLocalizer["CmsRole"]</th>
                            <th class="px-6 py-4 text-start">@SharedLocalizer["CmsStatus"]</th>
                            <th class="px-6 py-4 text-start">@SharedLocalizer["CmsCreated"]</th>
                            <th class="px-6 py-4 text-end">@SharedLocalizer["CmsActions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                        @foreach (var user in Model)
                        {
                            <tr class="hover:bg-slate-50/70 dark:hover:bg-white/[0.02] transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#00B2EC] to-[#10B981] text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-sm">
                                            @(string.IsNullOrWhiteSpace(user.FirstName) ? "U" : user.FirstName.Substring(0, 1).ToUpperInvariant())
                                        </div>
                                        <div class="min-w-0">
                                            <p class="font-semibold text-slate-900 dark:text-white">@user.FullName</p>
                                            <p class="text-xs text-slate-400 font-mono">@user.Email</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-semibold @(role == "Admin" ? "bg-[#00B2EC]/10 text-[#00B2EC]" : "bg-purple-500/10 text-purple-500")">
                                            @role
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    @if (user.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            @SharedLocalizer["CmsActive"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-500/10 text-red-600 dark:text-red-400">
                                            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                            @SharedLocalizer["CmsLocked"]
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-400">
                                    @user.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="px-6 py-4 text-end">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-controller="CmsUser" asp-action="ResetPassword" asp-route-id="@user.Id"
                                           class="p-2 rounded-xl text-slate-400 hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-500/10 transition-colors" title="@SharedLocalizer["CmsResetPassword"]">
                                            <span class="material-symbols-outlined text-[18px]">key</span>
                                        </a>
                                        <a asp-controller="CmsUser" asp-action="Edit" asp-route-id="@user.Id"
                                           class="p-2 rounded-xl text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/10 transition-colors" title="@SharedLocalizer["CmsEditUser"]">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>
                                        <form asp-controller="CmsUser" asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="p-2 rounded-xl text-slate-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors"
                                                    title="@(user.IsActive ? SharedLocalizer["CmsDeactivateUser"].Value : SharedLocalizer["CmsActivateUser"].Value)">
                                                <span class="material-symbols-outlined text-[18px]">@(user.IsActive ? "lock" : "lock_open")</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
