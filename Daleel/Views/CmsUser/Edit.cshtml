@model Daleel.Models.EditCmsUserViewModel
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = $"Edit User: {Model.FirstName} {Model.LastName}";
}

<div class="max-w-2xl mx-auto space-y-6">

    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-controller="CmsUser" asp-action="Index"
           class="p-2 rounded-xl border border-slate-200 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-white/5 text-slate-500 transition-colors">
            <span class="material-symbols-outlined text-[20px] rtl:rotate-180">arrow_back</span>
        </a>
        <div>
            <h2 class="font-poppins text-2xl font-bold text-brand-navy dark:text-white">@SharedLocalizer["CmsEditCmsUser"]</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">@SharedLocalizer["CmsEditUserDesc"]</p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-th-card dark:bg-th-d-card p-6 sm:p-8 rounded-3xl border border-slate-200/80 dark:border-white/10 shadow-sm space-y-6">
        <form method="post" asp-controller="CmsUser" asp-action="Edit" asp-route-id="@Model.Id" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-xs text-red-500 bg-red-50 dark:bg-red-500/10 p-3.5 rounded-xl border border-red-200 dark:border-red-500/20 hidden:empty"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="FirstName" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsFirstName"]</label>
                    <input asp-for="FirstName" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
                    <span asp-validation-for="FirstName" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsLastName"]</label>
                    <input asp-for="LastName" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
                    <span asp-validation-for="LastName" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsWorkEmail"]</label>
                <input asp-for="Email" type="email" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
                <span asp-validation-for="Email" class="text-[11px] text-red-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Role" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">@SharedLocalizer["CmsAccessRole"]</label>
                <select asp-for="Role" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky">
                    <option value="Admin">@SharedLocalizer["CmsRoleAdminFull"]</option>
                    <option value="Staff">@SharedLocalizer["CmsRoleStaff"]</option>
                </select>
                <span asp-validation-for="Role" class="text-[11px] text-red-500 mt-1 block"></span>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded text-th-sky focus:ring-th-sky border-slate-300 dark:border-white/10" />
                <label asp-for="IsActive" class="text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">@SharedLocalizer["CmsAccountActive"]</label>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-slate-100 dark:border-white/10">
                <a asp-controller="CmsUser" asp-action="ResetPassword" asp-route-id="@Model.Id"
                   class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-amber-200 dark:border-amber-500/20 bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-semibold hover:bg-amber-100 transition-colors">
                    <span class="material-symbols-outlined text-[16px]">key</span>
                    <span>@SharedLocalizer["CmsResetPassword"]</span>
                </a>

                <div class="flex items-center gap-3">
                    <a asp-controller="CmsUser" asp-action="Index"
                       class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
                        @SharedLocalizer["CmsCancel"]
                    </a>
                    <button type="submit"
                            class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-th-sky to-[#10B981] text-white font-semibold text-xs transition-all shadow-md shadow-th-sky/20 hover:opacity-95">
                        @SharedLocalizer["CmsSaveChanges"]
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
