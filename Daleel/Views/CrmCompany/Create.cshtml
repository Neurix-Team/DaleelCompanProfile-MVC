@model Daleel.Models.CompanyFormViewModel
@{
    Layout = "_CrmLayout";
    ViewData["Title"] = SharedLocalizer["CrmNewCompany"].Value;
}

<div class="max-w-3xl">
    <a asp-action="Index" class="inline-flex items-center gap-1 text-sm text-slate-500 dark:text-slate-400 hover:text-th-sky transition-colors mb-5">
        <span class="material-symbols-outlined text-[18px] rtl:rotate-180">arrow_back</span>
        @SharedLocalizer["CrmBackToCompanies"]
    </a>

    <div class="bg-th-card dark:bg-th-d-raised rounded-xl border border-slate-200 dark:border-white/10 p-6 sm:p-8">
        <form asp-action="Create" method="post" novalidate>
            @Html.AntiForgeryToken()

            @await Html.PartialAsync("_Form", Model)

            <div class="mt-8 flex items-center gap-3">
                <button type="submit"
                        class="rounded-lg bg-th-sky hover:bg-th-sky-strong text-white font-semibold text-sm px-5 py-2.5 transition-colors">
                    @SharedLocalizer["CrmSave"]
                </button>
                <a asp-action="Index"
                   class="rounded-lg border border-slate-300 dark:border-white/15 text-sm px-5 py-2.5 hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
                    @SharedLocalizer["CrmCancel"]
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

