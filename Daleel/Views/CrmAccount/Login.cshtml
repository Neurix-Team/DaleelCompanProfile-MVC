@model Daleel.Models.LoginViewModel
@using System.Globalization
@{
    Layout = null;
    ViewData["Title"] = SharedLocalizer["CrmSignInTitle"].Value;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var langCode = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var dir = isRtl ? "rtl" : "ltr";
    var returnUrl = ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString;
    var otherLang = langCode == "ar" ? "en" : "ar";
    var otherLangLabel = langCode == "ar" ? "English" : "العربية";
}
<!DOCTYPE html>
<html lang="@langCode" dir="@dir" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Daleel CRM</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        /* Standard ASP.NET validation classes */
        .validation-summary-valid { display: none; }
        .field-validation-valid { display: none; }
    </style>
    <partial name="_ThemeStyles" />
</head>
<body class="@(isRtl ? "font-cairo" : "font-inter") bg-slate-50 dark:bg-th-d-bg text-slate-900 dark:text-white min-h-screen flex items-center justify-center px-4 py-10">

    <div class="w-full max-w-md">

        <!-- Top bar: Lang switcher -->
        <div class="flex justify-end mb-4">
            <a asp-controller="Language" asp-action="SetLanguage"
               asp-route-culture="@otherLang"
               asp-route-returnUrl="@returnUrl"
               class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-white/10 text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-th-sky dark:hover:text-th-sky bg-th-card dark:bg-th-d-raised shadow-sm transition-colors">
                <span class="material-symbols-outlined text-[16px]">translate</span>
                @otherLangLabel
            </a>
        </div>

        <div class="text-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="inline-block">
                <img src="~/assets/Logo/Daleel.png" alt="Daleel"
                     class="h-12 w-auto mx-auto dark:brightness-0 dark:invert" />
            </a>
            <h1 class="mt-6 font-poppins font-semibold text-2xl text-brand-navy dark:text-white">
                @SharedLocalizer["CrmSignInTitle"]
            </h1>
            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                @SharedLocalizer["CrmSignInSubtitle"]
            </p>
        </div>

        <div class="bg-th-card dark:bg-th-d-raised rounded-2xl shadow-[0_10px_40px_rgba(29,49,102,0.10)] dark:shadow-[0_10px_40px_rgba(0,0,0,0.45)] border border-slate-200 dark:border-white/10 p-6 sm:p-8">

            <form asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly"
                     class="mb-5 rounded-lg bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/25 px-4 py-3 text-sm text-red-700 dark:text-red-400 [&_ul]:list-none [&_ul]:m-0 [&_ul]:p-0">
                </div>

                <div class="mb-5">
                    <label asp-for="Email" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"></label>
                    <input asp-for="Email" type="email" autocomplete="username" autofocus
                           placeholder="you@company.com"
                           class="w-full rounded-lg border border-slate-300 dark:border-white/15 bg-th-card dark:bg-th-d-bg px-4 py-2.5 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-th-sky focus:ring-2 focus:ring-th-sky/30 outline-none transition" />
                    <span asp-validation-for="Email" class="mt-1.5 block text-xs text-red-600 dark:text-red-400"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="Password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"></label>
                    <input asp-for="Password" type="password" autocomplete="current-password"
                           placeholder="••••••••"
                           class="w-full rounded-lg border border-slate-300 dark:border-white/15 bg-th-card dark:bg-th-d-bg px-4 py-2.5 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:border-th-sky focus:ring-2 focus:ring-th-sky/30 outline-none transition" />
                    <span asp-validation-for="Password" class="mt-1.5 block text-xs text-red-600 dark:text-red-400"></span>
                </div>

                <div class="mb-6 flex items-center gap-2">
                    <input asp-for="RememberMe" type="checkbox"
                           class="rounded border-slate-300 dark:border-white/20 text-th-sky focus:ring-th-sky/30" />
                    <label asp-for="RememberMe" class="text-sm text-slate-600 dark:text-slate-300 select-none"></label>
                </div>

                <button type="submit"
                        class="w-full rounded-lg bg-th-sky hover:bg-th-sky-strong text-white font-semibold text-sm py-3 transition-colors focus:outline-none focus:ring-2 focus:ring-th-sky/40 focus:ring-offset-2 dark:focus:ring-offset-th-d-raised">
                    @SharedLocalizer["CrmSignInButton"]
                </button>
            </form>
        </div>

        <p class="mt-6 text-center text-sm">
            <a asp-controller="Home" asp-action="Index"
               class="text-slate-500 dark:text-slate-400 hover:text-th-sky transition-colors inline-flex items-center gap-1">
                <span class="material-symbols-outlined text-[18px] rtl:rotate-180">arrow_back</span>
                @SharedLocalizer["CrmBackToWebsite"]
            </a>
        </p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>

