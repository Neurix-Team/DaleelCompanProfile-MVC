@using System.Globalization
@{
    Layout = null;
    ViewData["Title"] = SharedLocalizer["CrmAccessDeniedTitle"].Value;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var langCode = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var dir = isRtl ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@langCode" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Daleel CRM</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Poppins:wght@600&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <partial name="_ThemeStyles" />
</head>
<body class="@(isRtl ? "font-cairo" : "font-inter") bg-slate-50 dark:bg-th-d-bg text-slate-900 dark:text-white min-h-screen flex items-center justify-center px-4">
    <div class="text-center max-w-md">
        <div class="w-16 h-16 mx-auto rounded-full bg-red-50 dark:bg-red-500/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-red-600 dark:text-red-400 text-[32px]">lock</span>
        </div>
        <h1 class="mt-6 font-poppins font-semibold text-2xl text-brand-navy dark:text-white">@SharedLocalizer["CrmAccessDeniedTitle"]</h1>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
            @SharedLocalizer["CrmAccessDeniedMessage"]
        </p>
        <div class="mt-8 flex items-center justify-center gap-3">
            <a asp-controller="CrmDashboard" asp-action="Index"
               class="rounded-lg bg-th-sky hover:bg-th-sky-strong text-white font-semibold text-sm px-5 py-2.5 transition-colors">
                @SharedLocalizer["CrmGoToDashboard"]
            </a>
            <a asp-controller="Home" asp-action="Index"
               class="rounded-lg border border-slate-300 dark:border-white/15 hover:bg-slate-100 dark:hover:bg-white/5 text-sm px-5 py-2.5 transition-colors">
                @SharedLocalizer["CrmBackToWebsite"]
            </a>
        </div>
    </div>
</body>
</html>

