@model Daleel.Models.TestimonialFormViewModel

<div class="space-y-6">
    <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 text-sm"></div>

    <!-- Customer Identity & Brand -->
    <div class="bg-white dark:bg-[#0B1728] p-6 sm:p-8 rounded-2xl border border-slate-200/80 dark:border-white/10 shadow-sm space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100 dark:border-white/5">
            <span class="material-symbols-outlined text-[#00B2EC] text-[24px]">person_pin</span>
            <div>
                <h3 class="font-poppins font-bold text-lg text-brand-navy dark:text-white">@SharedLocalizer["CmsCustomerCompanyInfo"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">@SharedLocalizer["CmsReviewerProfileDesc"]</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-1.5 md:col-span-2">
                <label asp-for="BrandId" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsCompanyBrandProfile"] <span class="text-red-500">*</span>
                </label>
                <select asp-for="BrandId" asp-items="Model.BrandOptions"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]">
                </select>
                <span asp-validation-for="BrandId" class="text-xs text-red-500 block"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="CustomerNameEn" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldCustomerNameEn"] <span class="text-red-500">*</span>
                </label>
                <input asp-for="CustomerNameEn" placeholder="@SharedLocalizer["CmsEgCustomerName"]"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="CustomerNameEn" class="text-xs text-red-500 block"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="CustomerNameAr" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldCustomerNameAr"] <span class="text-red-500">*</span>
                </label>
                <input asp-for="CustomerNameAr" dir="rtl" placeholder="مثال: فهد الحسيني"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="CustomerNameAr" class="text-xs text-red-500 block"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="CompanyNameEn" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldCompanyNameEn"]
                </label>
                <input asp-for="CompanyNameEn" placeholder="@SharedLocalizer["CmsEgCompanyName"]"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="CompanyNameEn" class="text-xs text-red-500 block"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="CompanyNameAr" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldCompanyNameAr"]
                </label>
                <input asp-for="CompanyNameAr" dir="rtl" placeholder="مثال: شركة الرياض للخدمات اللوجستية"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="CompanyNameAr" class="text-xs text-red-500 block"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="RoleTitleEn" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsJobTitleRoleEn"]
                </label>
                <input asp-for="RoleTitleEn" placeholder="@SharedLocalizer["CmsEgRoleTitle"]"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="RoleTitleEn" class="text-xs text-red-500 block"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="RoleTitleAr" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsJobTitleRoleAr"]
                </label>
                <input asp-for="RoleTitleAr" dir="rtl" placeholder="مثال: نائب رئيس العمليات"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
                <span asp-validation-for="RoleTitleAr" class="text-xs text-red-500 block"></span>
            </div>
        </div>
    </div>

    <!-- Review Quote & Rating -->
    <div class="bg-white dark:bg-[#0B1728] p-6 sm:p-8 rounded-2xl border border-slate-200/80 dark:border-white/10 shadow-sm space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100 dark:border-white/5">
            <span class="material-symbols-outlined text-[#F9A01B] text-[24px]">rate_review</span>
            <div>
                <h3 class="font-poppins font-bold text-lg text-brand-navy dark:text-white">@SharedLocalizer["CmsReviewRating"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">@SharedLocalizer["CmsReviewRatingDesc"]</p>
            </div>
        </div>

        <div class="space-y-6">
            <div class="space-y-1.5 max-w-xs">
                <label asp-for="Rating" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsRatingStars"] <span class="text-red-500">*</span>
                </label>
                <select asp-for="Rating"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#F9A01B]">
                    <option value="5">@SharedLocalizer["CmsStars5"]</option>
                    <option value="4">@SharedLocalizer["CmsStars4"]</option>
                    <option value="3">@SharedLocalizer["CmsStars3"]</option>
                    <option value="2">@SharedLocalizer["CmsStars2"]</option>
                    <option value="1">@SharedLocalizer["CmsStars1"]</option>
                </select>
                <span asp-validation-for="Rating" class="text-xs text-red-500 block"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-1.5">
                    <label asp-for="ContentEn" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        @SharedLocalizer["CmsTestimonialQuoteEn"] <span class="text-red-500">*</span>
                    </label>
                    <textarea asp-for="ContentEn" rows="4" placeholder="@SharedLocalizer["CmsQuoteEnPlaceholder"]"
                              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#F9A01B]"></textarea>
                    <span asp-validation-for="ContentEn" class="text-xs text-red-500 block"></span>
                </div>

                <div class="space-y-1.5">
                    <label asp-for="ContentAr" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        @SharedLocalizer["CmsTestimonialQuoteAr"] <span class="text-red-500">*</span>
                    </label>
                    <textarea asp-for="ContentAr" dir="rtl" rows="4" placeholder="نص التقييم ورأي العميل بالعربية..."
                              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#F9A01B]"></textarea>
                    <span asp-validation-for="ContentAr" class="text-xs text-red-500 block"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Media & Visibility -->
    <div class="bg-white dark:bg-[#0B1728] p-6 sm:p-8 rounded-2xl border border-slate-200/80 dark:border-white/10 shadow-sm space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100 dark:border-white/5">
            <span class="material-symbols-outlined text-[#8B5CF6] text-[24px]">photo_camera</span>
            <div>
                <h3 class="font-poppins font-bold text-lg text-brand-navy dark:text-white">@SharedLocalizer["CmsPhotoPublishing"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">@SharedLocalizer["CmsCustomerHeadshotDesc"]</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-1.5">
                <label asp-for="DisplayOrder" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsDisplayOrderLabel"]
                </label>
                <input asp-for="DisplayOrder" type="number"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#8B5CF6]" />
                <span asp-validation-for="DisplayOrder" class="text-xs text-red-500 block"></span>
                <p class="text-[11px] text-slate-400">@SharedLocalizer["CmsOrderHint"]</p>
            </div>

            <div class="space-y-1.5 flex flex-col justify-center">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                    @SharedLocalizer["CmsPublishingStatus"]
                </label>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" asp-for="IsPublished" class="sr-only peer">
                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-white/10 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                    <span class="ms-3 text-sm font-medium text-slate-700 dark:text-slate-300">@SharedLocalizer["CmsPublishedLive"]</span>
                </label>
            </div>

            <div class="space-y-2 md:col-span-2 pt-2">
                <label asp-for="PhotoFile" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsCustomerPhotoOptional"]
                </label>
                <input type="file" asp-for="PhotoFile" accept="image/*"
                       class="w-full text-sm text-slate-500 file:me-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#00B2EC]/10 file:text-[#00B2EC] hover:file:bg-[#00B2EC]/20 cursor-pointer" />
                <span asp-validation-for="PhotoFile" class="text-xs text-red-500 block"></span>

                @if (!string.IsNullOrWhiteSpace(Model.ExistingPhotoPath))
                {
                    <div id="testimonialExistingPhotoContainer" class="flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/5 mt-2">
                        <div class="flex items-center gap-3 min-w-0">
                            <input type="hidden" asp-for="ExistingPhotoPath" id="testimonialExistingPhotoInput" />
                            <img src="@Model.ExistingPhotoPath" alt="@SharedLocalizer["CmsCurrentPhoto"]" class="h-14 w-14 object-cover rounded-full shrink-0" onerror="this.style.display='none'" />
                            <span class="text-xs text-slate-500 truncate max-w-xs">@Model.ExistingPhotoPath</span>
                        </div>
                        <button type="button" onclick="document.getElementById('testimonialExistingPhotoInput').value=''; document.getElementById('testimonialExistingPhotoContainer').remove();" class="text-xs text-red-500 hover:text-red-600 font-medium px-2.5 py-1.5 rounded-lg hover:bg-red-500/10 transition-colors flex items-center gap-1 shrink-0">
                            <span class="material-symbols-outlined text-[16px]">delete</span>
                            <span>@SharedLocalizer["CmsDelete"]</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center justify-end gap-3 pt-4">
        <a asp-controller="Testimonial" asp-action="Index"
           class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 font-medium text-sm transition-colors">
            @SharedLocalizer["CmsCancel"]
        </a>
        <button type="submit"
                class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#00B2EC] to-[#10B981] text-white font-semibold text-sm transition-all shadow-lg shadow-[#00B2EC]/20 hover:opacity-95 hover:scale-[1.02]">
            @SharedLocalizer["CmsSaveTestimonial"]
        </button>
    </div>
</div>
