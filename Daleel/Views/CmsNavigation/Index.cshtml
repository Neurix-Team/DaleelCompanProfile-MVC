@model Daleel.Models.NavigationIndexViewModel
@using Daleel.DAL.Entities
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = SharedLocalizer["CmsNavigationTitle"]?.Value ?? "Navigation Links";
    var activeTab = Model.ActiveTab;
}

<div class="space-y-6">

    <!-- Header & Action Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="font-poppins text-2xl font-bold text-brand-navy dark:text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-[#00B2EC] text-[28px]">menu_book</span>
                <span>@(SharedLocalizer["CmsNavigationTitle"]?.Value ?? "Navigation & Menu Links")</span>
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                @(SharedLocalizer["CmsNavigationSubtitle"]?.Value ?? "Manage Header and Footer navigation links, ordering, URLs, and multi-language labels.")
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-controller="CmsNavigation" asp-action="Create" asp-route-location="@(activeTab == "header" ? NavigationLocation.Header : NavigationLocation.Footer)" asp-route-section="@(activeTab == "company" ? FooterSection.Company : (activeTab == "stayinformed" ? FooterSection.StayInformed : (activeTab == "platform" ? FooterSection.Platform : (FooterSection?)null)))"
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#00B2EC] to-[#10B981] text-white font-semibold text-sm transition-all shadow-lg shadow-[#00B2EC]/20 hover:opacity-95 hover:scale-[1.02]">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>@(SharedLocalizer["CmsAddLink"]?.Value ?? "Add Link")</span>
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    <!-- Tabs Navigation -->
    <div class="border-b border-slate-200 dark:border-white/10 flex flex-wrap gap-2 text-sm font-semibold">
        <a href="?tab=header"
           class="px-5 py-3 border-b-2 transition-all flex items-center gap-2 @(activeTab == "header" ? "border-[#00B2EC] text-[#00B2EC] bg-[#00B2EC]/5 rounded-t-xl" : "border-transparent text-slate-500 hover:text-slate-900 dark:hover:text-white")">
            <span class="material-symbols-outlined text-[18px]">web</span>
            <span>@(SharedLocalizer["CmsHeaderNav"]?.Value ?? "Header Navigation")</span>
            <span class="ms-1 px-2 py-0.5 text-xs rounded-full bg-slate-100 dark:bg-white/10 font-bold">@Model.Navigation.HeaderLinks.Count</span>
        </a>

        <a href="?tab=platform"
           class="px-5 py-3 border-b-2 transition-all flex items-center gap-2 @(activeTab == "platform" ? "border-[#00B2EC] text-[#00B2EC] bg-[#00B2EC]/5 rounded-t-xl" : "border-transparent text-slate-500 hover:text-slate-900 dark:hover:text-white")">
            <span class="material-symbols-outlined text-[18px]">view_column</span>
            <span>@(SharedLocalizer["CmsFooterPlatform"]?.Value ?? "Footer: Platform")</span>
            <span class="ms-1 px-2 py-0.5 text-xs rounded-full bg-slate-100 dark:bg-white/10 font-bold">@Model.Navigation.FooterPlatformLinks.Count</span>
        </a>

        <a href="?tab=company"
           class="px-5 py-3 border-b-2 transition-all flex items-center gap-2 @(activeTab == "company" ? "border-[#00B2EC] text-[#00B2EC] bg-[#00B2EC]/5 rounded-t-xl" : "border-transparent text-slate-500 hover:text-slate-900 dark:hover:text-white")">
            <span class="material-symbols-outlined text-[18px]">corporate_fare</span>
            <span>@(SharedLocalizer["CmsFooterCompany"]?.Value ?? "Footer: Company")</span>
            <span class="ms-1 px-2 py-0.5 text-xs rounded-full bg-slate-100 dark:bg-white/10 font-bold">@Model.Navigation.FooterCompanyLinks.Count</span>
        </a>

        <a href="?tab=stayinformed"
           class="px-5 py-3 border-b-2 transition-all flex items-center gap-2 @(activeTab == "stayinformed" ? "border-[#00B2EC] text-[#00B2EC] bg-[#00B2EC]/5 rounded-t-xl" : "border-transparent text-slate-500 hover:text-slate-900 dark:hover:text-white")">
            <span class="material-symbols-outlined text-[18px]">mark_email_read</span>
            <span>@(SharedLocalizer["CmsFooterStayInformed"]?.Value ?? "Footer: Stay Informed")</span>
            <span class="ms-1 px-2 py-0.5 text-xs rounded-full bg-slate-100 dark:bg-white/10 font-bold">@Model.Navigation.FooterStayInformedLinks.Count</span>
        </a>
    </div>

    <!-- Active Tab Content -->
    @{
        IReadOnlyList<Daleel.BAL.Models.NavigationLinkDto> currentLinks = activeTab switch
        {
            "platform" => Model.Navigation.FooterPlatformLinks,
            "company" => Model.Navigation.FooterCompanyLinks,
            "stayinformed" => Model.Navigation.FooterStayInformedLinks,
            _ => Model.Navigation.HeaderLinks
        };
    }

    <div class="bg-white dark:bg-[#0B1728] rounded-2xl border border-slate-200/80 dark:border-white/10 shadow-sm overflow-hidden">
        @if (currentLinks.Count == 0)
        {
            <div class="p-12 text-center">
                <div class="w-16 h-16 rounded-2xl bg-[#00B2EC]/10 text-[#00B2EC] flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-[32px]">link_off</span>
                </div>
                <h3 class="font-poppins font-bold text-lg text-slate-800 dark:text-slate-200">
                    @(SharedLocalizer["CmsNoLinksFound"]?.Value ?? "No links in this section yet")
                </h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-sm mx-auto">
                    @(SharedLocalizer["CmsNoLinksDesc"]?.Value ?? "Add your first navigation link using the button above.")
                </p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-start text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400">
                            <th class="py-3.5 px-4 text-start font-semibold w-16">#</th>
                            <th class="py-3.5 px-4 text-start font-semibold">@(SharedLocalizer["CmsEnglishLabel"]?.Value ?? "English Label")</th>
                            <th class="py-3.5 px-4 text-start font-semibold">@(SharedLocalizer["CmsArabicLabel"]?.Value ?? "Arabic Label")</th>
                            <th class="py-3.5 px-4 text-start font-semibold">@(SharedLocalizer["CmsUrlPath"]?.Value ?? "Target URL / Path")</th>
                            <th class="py-3.5 px-4 text-center font-semibold w-24">@(SharedLocalizer["CmsSortOrder"]?.Value ?? "Sort")</th>
                            <th class="py-3.5 px-4 text-center font-semibold w-28">@(SharedLocalizer["CmsStatus"]?.Value ?? "Status")</th>
                            <th class="py-3.5 px-4 text-end font-semibold w-32">@(SharedLocalizer["CmsActions"]?.Value ?? "Actions")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-white/10">
                        @foreach (var link in currentLinks)
                        {
                            <tr class="hover:bg-slate-50/80 dark:hover:bg-white/5 transition-colors">
                                <td class="py-3.5 px-4 font-mono text-xs text-slate-400">
                                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-white/5 font-bold text-slate-600 dark:text-slate-300">
                                        @link.SortOrder
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 font-medium text-slate-900 dark:text-white">
                                    @link.LabelEn
                                    @if (link.OpenInNewTab)
                                    {
                                        <span class="inline-flex items-center text-slate-400 ms-1 text-[13px]" title="Opens in new tab">
                                            <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-slate-700 dark:text-slate-300 font-['Cairo']">
                                    @link.LabelAr
                                </td>
                                <td class="py-3.5 px-4 font-mono text-xs text-[#00B2EC] dark:text-[#77d1ff]">
                                    <a href="@link.Url" target="_blank" class="hover:underline flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[14px]">link</span>
                                        <span>@link.Url</span>
                                    </a>
                                </td>
                                <td class="py-3.5 px-4 text-center font-mono text-xs">
                                    @link.SortOrder
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <form method="post" asp-controller="CmsNavigation" asp-action="ToggleActive" asp-route-id="@link.Id" asp-route-tab="@activeTab" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold transition-all @(link.IsActive ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 hover:bg-emerald-500/20" : "bg-slate-200/60 dark:bg-white/10 text-slate-500 dark:text-slate-400 border border-slate-300 dark:border-white/10 hover:bg-slate-300/60")"
                                                title="@(link.IsActive ? "Click to deactivate" : "Click to activate")">
                                            <span class="w-1.5 h-1.5 rounded-full @(link.IsActive ? "bg-emerald-500" : "bg-slate-400")"></span>
                                            <span>@(link.IsActive ? (SharedLocalizer["CmsActive"]?.Value ?? "Active") : (SharedLocalizer["CmsInactive"]?.Value ?? "Inactive"))</span>
                                        </button>
                                    </form>
                                </td>
                                <td class="py-3.5 px-4 text-end">
                                    <div class="inline-flex items-center gap-1">
                                        <a asp-controller="CmsNavigation" asp-action="Edit" asp-route-id="@link.Id"
                                           class="p-1.5 rounded-lg text-slate-500 hover:text-[#00B2EC] hover:bg-[#00B2EC]/10 transition-colors"
                                           title="@(SharedLocalizer["CmsEdit"]?.Value ?? "Edit")">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </a>

                                        <form method="post" asp-controller="CmsNavigation" asp-action="Delete" asp-route-id="@link.Id" asp-route-tab="@activeTab"
                                              onsubmit="return confirm('@(SharedLocalizer["CmsConfirmDeleteLink"]?.Value ?? "Are you sure you want to delete this navigation link?")');"
                                              class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="p-1.5 rounded-lg text-slate-500 hover:text-rose-500 hover:bg-rose-500/10 transition-colors"
                                                    title="@(SharedLocalizer["CmsDelete"]?.Value ?? "Delete")">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Quick Reference / Help Card -->
    <div class="p-5 rounded-2xl bg-gradient-to-r from-[#00B2EC]/5 via-transparent to-[#10B981]/5 border border-slate-200/80 dark:border-white/10 text-xs text-slate-600 dark:text-slate-400">
        <h4 class="font-bold text-slate-800 dark:text-slate-200 mb-2 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[#00B2EC] text-[18px]">info</span>
            <span>@(SharedLocalizer["CmsQuickRouteSuggestions"]?.Value ?? "Common Target URLs")</span>
        </h4>
        <div class="flex flex-wrap gap-2 pt-1 font-mono">
            <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10">/ (Home)</span>
            <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10">/Home/Platforms</span>
            <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10">/Home/Shop</span>
            <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10">/Home/Trust</span>
            <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10">/Home/About</span>
            <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10">/Home/Blog</span>
            <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10">/Home/Contact</span>
            <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10">/Home/Soon</span>
        </div>
    </div>

</div>
