@using System.Globalization
@model Daleel.BAL.Models.PagedResult<Daleel.BAL.Models.CmsProjectListItemDto>
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = SharedLocalizer["CmsTitlePortfolioProjects"].Value;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var brands = ViewData["Brands"] as IReadOnlyList<Daleel.BAL.Models.BrandProfileListItemDto> ?? Array.Empty<Daleel.BAL.Models.BrandProfileListItemDto>();
    var currentBrandId = ViewData["CurrentBrandId"] as int?;
    var currentQ = ViewData["CurrentQ"]?.ToString();
    var currentIsPublished = ViewData["CurrentIsPublished"] as bool?;
}

<div class="space-y-6">

    <!-- Header & Action Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="font-poppins text-2xl font-bold text-brand-navy dark:text-white">
                @SharedLocalizer["CmsTitlePortfolioProjects"]
            </h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                @SharedLocalizer["CmsProjectsIntro"]
            </p>
        </div>
        <a asp-controller="CmsProject" asp-action="Create" asp-route-brandId="@currentBrandId"
           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#00B2EC] to-[#10B981] text-white font-semibold text-sm transition-all shadow-lg shadow-[#00B2EC]/20 hover:opacity-95 hover:scale-[1.02] self-start sm:self-auto">
            <span class="material-symbols-outlined text-[20px]">add</span>
            <span>@SharedLocalizer["CmsNewProject"]</span>
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-sm flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    <!-- Filters & Search Bar -->
    <form method="get" asp-controller="CmsProject" asp-action="Index"
          class="bg-white dark:bg-[#0B1728] p-4 rounded-2xl border border-slate-200/80 dark:border-white/10 shadow-sm flex flex-col md:flex-row items-center gap-3">

        <!-- Brand Selector Filter -->
        <div class="w-full md:w-64">
            <select name="brandId"
                    class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-[#0B1728] text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]">
                <option value="">@SharedLocalizer["CmsAllBrandProfiles"]</option>
                @foreach (var b in brands)
                {
                    var bName = isRtl && !string.IsNullOrWhiteSpace(b.NameAr) ? $"{b.NameAr} ({b.NameEn})" : $"{b.NameEn} ({b.NameAr})";
                    <option value="@b.Id" selected="@(currentBrandId == b.Id ? "selected" : null)">@bName</option>
                }
            </select>
        </div>

        <!-- Search Input -->
        <div class="relative flex-1 w-full">
            <span class="material-symbols-outlined absolute start-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">search</span>
            <input type="text" name="q" value="@currentQ" placeholder="@SharedLocalizer["CmsSearchProjects"]"
                   class="w-full ps-10 pe-4 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]" />
        </div>

        <!-- Status Filter -->
        <div class="w-full md:w-44">
            <select name="isPublished"
                    class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-[#0B1728] text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#00B2EC]">
                <option value="">@SharedLocalizer["CmsAllStatuses"]</option>
                <option value="true" selected="@(currentIsPublished == true ? "selected" : null)">@SharedLocalizer["CmsPublishedOnly"]</option>
                <option value="false" selected="@(currentIsPublished == false ? "selected" : null)">@SharedLocalizer["CmsDraftsOnly"]</option>
            </select>
        </div>

        <!-- Filter Submit & Reset -->
        <div class="flex items-center gap-2 w-full md:w-auto">
            <button type="submit"
                    class="flex-1 md:flex-none px-4 py-2 rounded-xl bg-slate-900 dark:bg-white dark:text-slate-900 text-white font-medium text-sm hover:opacity-90 transition-all">
                @SharedLocalizer["CmsFilter"]
            </button>
            @if (currentBrandId.HasValue || !string.IsNullOrWhiteSpace(currentQ) || currentIsPublished.HasValue)
            {
                <a asp-controller="CmsProject" asp-action="Index"
                   class="p-2 rounded-xl border border-slate-200 dark:border-white/10 text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors" title="@SharedLocalizer["CmsClearFilters"]">
                    <span class="material-symbols-outlined text-[20px]">restart_alt</span>
                </a>
            }
        </div>
    </form>

    <!-- Projects Grid -->
    @if (Model.Items.Count == 0)
    {
        <div class="bg-white dark:bg-[#0B1728] p-12 text-center rounded-2xl border border-slate-200/80 dark:border-white/10">
            <div class="w-16 h-16 rounded-2xl bg-[#00B2EC]/10 text-[#00B2EC] flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-[32px]">folder_open</span>
            </div>
            <h3 class="font-poppins font-bold text-lg text-slate-800 dark:text-slate-200">@SharedLocalizer["CmsNoProjectsFound"]</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-sm mx-auto">@SharedLocalizer["CmsNoProjectsDesc"]</p>
            <a asp-controller="CmsProject" asp-action="Create" asp-route-brandId="@currentBrandId"
               class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#00B2EC] text-white text-sm font-semibold hover:opacity-90">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span>@SharedLocalizer["CmsCreateProject"]</span>
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var p in Model.Items)
            {
                var displayName = isRtl && !string.IsNullOrWhiteSpace(p.NameAr) ? p.NameAr : p.NameEn;
                var secondaryName = isRtl ? p.NameEn : p.NameAr;
                var brandName = isRtl && !string.IsNullOrWhiteSpace(p.BrandNameAr) ? p.BrandNameAr : p.BrandNameEn;
                var clientName = isRtl && !string.IsNullOrWhiteSpace(p.ClientNameAr) ? p.ClientNameAr : p.ClientNameEn;
                var shortDesc = isRtl && !string.IsNullOrWhiteSpace(p.ShortDescAr) ? p.ShortDescAr : p.ShortDescEn;

                <div class="bg-white dark:bg-[#0B1728] rounded-2xl border border-slate-200/80 dark:border-white/10 overflow-hidden shadow-sm hover:border-[#00B2EC]/40 transition-all flex flex-col justify-between group">
                    <div>
                        <!-- Cover Image or Placeholder -->
                        <div class="relative h-44 w-full bg-slate-100 dark:bg-white/5 overflow-hidden">
                            @if (!string.IsNullOrWhiteSpace(p.ImagePath))
                            {
                                <img src="@p.ImagePath" alt="@displayName" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                            }
                            else
                            {
                                <div class="w-full h-full flex flex-col items-center justify-center text-slate-400">
                                    <span class="material-symbols-outlined text-[40px]">apartment</span>
                                    <span class="text-xs mt-1">@brandName</span>
                                </div>
                            }

                            <!-- Top Badges Overlay -->
                            <div class="absolute top-3 start-3 end-3 flex items-center justify-between pointer-events-none">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold uppercase tracking-wider bg-black/60 backdrop-blur-md text-white">
                                    @brandName
                                </span>

                                @if (p.IsPublished)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/90 backdrop-blur-md text-white shadow-sm">
                                        <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                                        @SharedLocalizer["CmsLive"]
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-500/90 backdrop-blur-md text-white shadow-sm">
                                        <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                                        @SharedLocalizer["CmsDraft"]
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-6">
                            @if (!string.IsNullOrWhiteSpace(clientName))
                            {
                                <p class="text-xs font-semibold text-[#00B2EC] uppercase tracking-wider mb-1">
                                    @clientName
                                </p>
                            }

                            <h3 class="font-poppins font-bold text-lg text-brand-navy dark:text-white mb-1 group-hover:text-[#00B2EC] transition-colors line-clamp-1">
                                @displayName
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(secondaryName))
                            {
                                <p class="text-xs text-slate-400 @(isRtl ? "font-sans" : "font-cairo") mb-3" dir="@(isRtl ? "ltr" : "rtl")">@secondaryName</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(shortDesc))
                            {
                                <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed mb-4">
                                    @shortDesc
                                </p>
                            }

                            <!-- Metadata info -->
                            <div class="flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-100 dark:border-white/5">
                                <span>@(p.CompletionDate?.ToString("MMM yyyy") ?? SharedLocalizer["CmsOngoing"].Value)</span>
                                @if (!string.IsNullOrWhiteSpace(p.ProjectUrl))
                                {
                                    <a href="@p.ProjectUrl" target="_blank" class="text-[#00B2EC] hover:underline flex items-center gap-1">
                                        @SharedLocalizer["CmsDemo"] <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Footer: Order & Action Buttons -->
                    <div class="px-6 py-4 bg-slate-50/50 dark:bg-white/[0.02] border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
                        <span class="text-[11px] font-mono text-slate-400">
                            @SharedLocalizer["CmsOrderPrefix"] #@p.DisplayOrder
                        </span>

                        <div class="flex items-center gap-2">
                            <!-- Toggle Publish -->
                            <form asp-controller="CmsProject" asp-action="TogglePublish" asp-route-id="@p.Id" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/10 transition-colors"
                                        title="@(p.IsPublished ? SharedLocalizer["CmsUnpublishToDraft"].Value : SharedLocalizer["CmsPublishLiveTitle"].Value)">
                                    <span class="material-symbols-outlined text-[18px]">@(p.IsPublished ? "visibility_off" : "visibility")</span>
                                </button>
                            </form>

                            <!-- Edit -->
                            <a asp-controller="CmsProject" asp-action="Edit" asp-route-id="@p.Id"
                               class="p-1.5 rounded-lg text-slate-400 hover:text-[#00B2EC] hover:bg-[#00B2EC]/10 transition-colors" title="@SharedLocalizer["CmsEditProject"]">
                                <span class="material-symbols-outlined text-[18px]">edit</span>
                            </a>

                            <!-- Delete -->
                            <form asp-controller="CmsProject" asp-action="Delete" asp-route-id="@p.Id" method="post"
                                  onsubmit="return confirm('@(isRtl ? $"هل أنت متأكد من حذف {displayName}؟" : $"Are you sure you want to remove {displayName}?")');" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors" title="@SharedLocalizer["CmsDeleteProject"]">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex items-center justify-between pt-4">
                <p class="text-xs text-slate-500">
                    @SharedLocalizer["CmsShowingProjects", (Model.Page - 1) * Model.PageSize + 1, Math.Min(Model.Page * Model.PageSize, Model.TotalCount), Model.TotalCount]
                </p>

                <div class="flex items-center gap-1">
                    @if (Model.HasPrevious)
                    {
                        <a asp-controller="CmsProject" asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-brandId="@currentBrandId"
                           asp-route-q="@currentQ"
                           asp-route-isPublished="@currentIsPublished"
                           class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-white/10 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5">
                            @SharedLocalizer["CmsPrevious"]
                        </a>
                    }
                    @if (Model.HasNext)
                    {
                        <a asp-controller="CmsProject" asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-brandId="@currentBrandId"
                           asp-route-q="@currentQ"
                           asp-route-isPublished="@currentIsPublished"
                           class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-white/10 text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-white/5">
                            @SharedLocalizer["CmsNext"]
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>
