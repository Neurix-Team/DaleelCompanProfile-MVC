@model Daleel.Models.CmsServiceFormViewModel

<div class="space-y-6">
    <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 text-sm"></div>

    <!-- Brand Assignment & Basic Info -->
    <div class="bg-th-card dark:bg-th-d-card p-6 sm:p-8 rounded-2xl border border-slate-200/80 dark:border-white/10 shadow-sm space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100 dark:border-white/5">
            <span class="material-symbols-outlined text-th-sky text-[24px]">design_services</span>
            <div>
                <h3 class="font-poppins font-bold text-lg text-brand-navy dark:text-white">@SharedLocalizer["CmsServiceIdentityBrand"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">@SharedLocalizer["CmsTargetBrandHint"]</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Brand Selector -->
            <div class="space-y-1.5">
                <label asp-for="BrandId" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsCompanyBrandProfile"] <span class="text-red-500">*</span>
                </label>
                <select asp-for="BrandId" asp-items="Model.BrandOptions"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky">
                </select>
                <span asp-validation-for="BrandId" class="text-xs text-red-500 block"></span>
            </div>

            <!-- URL Slug -->
            <div class="space-y-1.5">
                <label asp-for="Slug" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsUrlSlugIdentifier"]
                </label>
                <input asp-for="Slug" placeholder="@SharedLocalizer["CmsEgServiceSlug"]"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
                <span asp-validation-for="Slug" class="text-xs text-red-500 block"></span>
                <p class="text-[11px] text-slate-400">@SharedLocalizer["CmsUniquePerBrand"]</p>
            </div>

            <!-- English Name -->
            <div class="space-y-1.5">
                <label asp-for="NameEn" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldServiceNameEn"] <span class="text-red-500">*</span>
                </label>
                <input asp-for="NameEn" placeholder="@SharedLocalizer["CmsEgServiceName"]"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
                <span asp-validation-for="NameEn" class="text-xs text-red-500 block"></span>
            </div>

            <!-- Arabic Name -->
            <div class="space-y-1.5">
                <label asp-for="NameAr" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldServiceNameAr"] <span class="text-red-500">*</span>
                </label>
                <input asp-for="NameAr" dir="rtl" placeholder="مثال: ذكاء الأعمال والتحليلات المؤسسية"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-th-sky" />
                <span asp-validation-for="NameAr" class="text-xs text-red-500 block"></span>
            </div>
        </div>
    </div>

    <!-- Descriptions & Summaries -->
    <div class="bg-th-card dark:bg-th-d-card p-6 sm:p-8 rounded-2xl border border-slate-200/80 dark:border-white/10 shadow-sm space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100 dark:border-white/5">
            <span class="material-symbols-outlined text-[#10B981] text-[24px]">description</span>
            <div>
                <h3 class="font-poppins font-bold text-lg text-brand-navy dark:text-white">@SharedLocalizer["CmsServiceContent"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">@SharedLocalizer["CmsServiceContentDesc"]</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Short Description EN -->
            <div class="space-y-1.5">
                <label asp-for="ShortDescEn" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldShortSummaryEn"]
                </label>
                <textarea asp-for="ShortDescEn" rows="2" placeholder="@SharedLocalizer["CmsBriefCardEnPlaceholder"]"
                          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#10B981]"></textarea>
                <span asp-validation-for="ShortDescEn" class="text-xs text-red-500 block"></span>
            </div>

            <!-- Short Description AR -->
            <div class="space-y-1.5">
                <label asp-for="ShortDescAr" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldShortSummaryAr"]
                </label>
                <textarea asp-for="ShortDescAr" dir="rtl" rows="2" placeholder="ملخص موجز للبطاقة بالعربية..."
                          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#10B981]"></textarea>
                <span asp-validation-for="ShortDescAr" class="text-xs text-red-500 block"></span>
            </div>

            <!-- Description EN -->
            <div class="space-y-1.5">
                <label asp-for="DescriptionEn" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldFullDescEn"]
                </label>
                <textarea asp-for="DescriptionEn" rows="5" placeholder="@SharedLocalizer["CmsServiceDetailEnPlaceholder"]"
                          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#10B981]"></textarea>
                <span asp-validation-for="DescriptionEn" class="text-xs text-red-500 block"></span>
            </div>

            <!-- Description AR -->
            <div class="space-y-1.5">
                <label asp-for="DescriptionAr" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldFullDescAr"]
                </label>
                <textarea asp-for="DescriptionAr" dir="rtl" rows="5" placeholder="شرح تفصيلي للمميزات والمواصفات بالعربية..."
                          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#10B981]"></textarea>
                <span asp-validation-for="DescriptionAr" class="text-xs text-red-500 block"></span>
            </div>
        </div>
    </div>

    <!-- Media, Icon & Display Settings -->
    <div class="bg-th-card dark:bg-th-d-card p-6 sm:p-8 rounded-2xl border border-slate-200/80 dark:border-white/10 shadow-sm space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100 dark:border-white/5">
            <span class="material-symbols-outlined text-[#F9A01B] text-[24px]">palette</span>
            <div>
                <h3 class="font-poppins font-bold text-lg text-brand-navy dark:text-white">@SharedLocalizer["CmsIconMediaOrdering"]</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">@SharedLocalizer["CmsIconMediaDesc"]</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Icon Name -->
            <div class="space-y-1.5">
                <label asp-for="IconName" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFldMaterialIcon"]
                </label>
                <div class="relative">
                    <input asp-for="IconName" placeholder="@SharedLocalizer["CmsEgIconNames"]"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#F9A01B]" />
                </div>
                <span asp-validation-for="IconName" class="text-xs text-red-500 block"></span>
                <p class="text-[11px] text-slate-400">@SharedLocalizer["CmsIconHint"]</p>
            </div>

            <!-- Display Order -->
            <div class="space-y-1.5">
                <label asp-for="DisplayOrder" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsDisplayOrderLabel"]
                </label>
                <input asp-for="DisplayOrder" type="number"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 bg-slate-50/50 dark:bg-white/5 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#F9A01B]" />
                <span asp-validation-for="DisplayOrder" class="text-xs text-red-500 block"></span>
                <p class="text-[11px] text-slate-400">@SharedLocalizer["CmsOrderHint"]</p>
            </div>

            <!-- Published Toggle -->
            <div class="space-y-1.5 flex flex-col justify-center">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                    @SharedLocalizer["CmsPublishingStatus"]
                </label>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" asp-for="IsPublished" class="sr-only peer">
                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-white/10 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                    <span class="ms-3 text-sm font-medium text-slate-700 dark:text-slate-300">@SharedLocalizer["CmsPublishedLive"]</span>
                </label>
            </div>

            <!-- Feature Image Upload -->
            <div class="space-y-2 md:col-span-3 pt-2">
                <label asp-for="ImageFile" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                    @SharedLocalizer["CmsFeatureImageOptional"]
                </label>
                <input type="file" asp-for="ImageFile" accept="image/*"
                       class="w-full text-sm text-slate-500 file:me-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-th-sky/10 file:text-th-sky hover:file:bg-th-sky/20 cursor-pointer" />
                <span asp-validation-for="ImageFile" class="text-xs text-red-500 block"></span>

                @if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath))
                {
                    <div id="serviceExistingImgContainer" class="flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/5 mt-2">
                        <div class="flex items-center gap-3 min-w-0">
                            <input type="hidden" asp-for="ExistingImagePath" id="serviceExistingImgInput" />
                            <img src="@Model.ExistingImagePath" alt="@SharedLocalizer["CmsCurrentImage"]" class="h-12 w-12 object-cover rounded-lg shrink-0" onerror="this.style.display='none'" />
                            <span class="text-xs text-slate-500 truncate max-w-xs">@Model.ExistingImagePath</span>
                        </div>
                        <button type="button" onclick="document.getElementById('serviceExistingImgInput').value=''; document.getElementById('serviceExistingImgContainer').remove();" class="text-xs text-red-500 hover:text-red-600 font-medium px-2.5 py-1.5 rounded-lg hover:bg-red-500/10 transition-colors flex items-center gap-1 shrink-0">
                            <span class="material-symbols-outlined text-[16px]">delete</span>
                            <span>@SharedLocalizer["CmsDelete"]</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center justify-end gap-3 pt-4">
        <a asp-controller="CmsService" asp-action="Index"
           class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 font-medium text-sm transition-colors">
            @SharedLocalizer["CmsCancel"]
        </a>
        <button type="submit"
                class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-th-sky to-[#10B981] text-white font-semibold text-sm transition-all shadow-lg shadow-th-sky/20 hover:opacity-95 hover:scale-[1.02]">
            @SharedLocalizer["CmsSaveService"]
        </button>
    </div>
</div>
