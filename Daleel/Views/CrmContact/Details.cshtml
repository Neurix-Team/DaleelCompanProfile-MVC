@model Daleel.DAL.Entities.Contact
@using Daleel.DAL.Entities
@{
    Layout = "_CrmLayout";
    ViewData["Title"] = Model.FullName;
    var confirmText = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
        $"Delete {Model.FullName}? This cannot be undone.");
}

<div class="max-w-4xl">

    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <a asp-action="Index" class="inline-flex items-center gap-1 text-sm text-slate-500 dark:text-slate-400 hover:text-[#00B2EC] transition-colors">
            <span class="material-symbols-outlined text-[18px] rtl:rotate-180">arrow_back</span>
            @SharedLocalizer["CrmBackToContacts"]
        </a>

        <div class="flex items-center gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="inline-flex items-center gap-2 rounded-lg border border-slate-300 dark:border-white/15 text-sm px-4 py-2.5 hover:bg-slate-100 dark:hover:bg-white/5 transition-colors">
                <span class="material-symbols-outlined text-[20px]">edit</span>
                @SharedLocalizer["CrmEdit"]
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline"
                  onsubmit="return confirm('@Html.Raw(confirmText)');">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-lg border border-red-200 dark:border-red-500/25 text-red-600 dark:text-red-400 text-sm px-4 py-2.5 hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors">
                    <span class="material-symbols-outlined text-[20px]">delete</span>
                    @SharedLocalizer["CrmDelete"]
                </button>
            </form>
        </div>
    </div>

    <div class="bg-white dark:bg-[#0F2542] rounded-xl border border-slate-200 dark:border-white/10 p-6 sm:p-8">

        <div class="flex items-start justify-between gap-4 mb-6">
            <div class="flex items-center gap-4 min-w-0">
                <div class="w-12 h-12 shrink-0 rounded-full bg-[#00B2EC] text-white flex items-center justify-center font-semibold">
                    @(Model.FirstName.Length > 0 ? Model.FirstName.Substring(0, 1).ToUpperInvariant() : "?")
                </div>
                <div class="min-w-0">
                    <h2 class="font-poppins font-semibold text-xl text-brand-navy dark:text-white break-words">@Model.FullName</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.JobTitle))
                    {
                        <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">@Model.JobTitle</p>
                    }
                </div>
            </div>
            <span class="shrink-0 inline-flex items-center rounded-full px-3 py-1 text-xs font-medium @(Model.Status == RecordStatus.Active ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400" : "bg-slate-100 text-slate-600 dark:bg-white/5 dark:text-slate-400")">
                @SharedLocalizer[$"CrmRecordStatus_{Model.Status}"]
            </span>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 text-sm">
            <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-slate-500">@SharedLocalizer["CrmEmail"]</dt>
                <dd class="mt-1 text-slate-700 dark:text-slate-200 break-words">
                    @if (string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <span class="text-slate-400">—</span>
                    }
                    else
                    {
                        <a href="mailto:@Model.Email" class="hover:text-[#00B2EC] transition-colors">@Model.Email</a>
                    }
                </dd>
            </div>

            <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-slate-500">@SharedLocalizer["CrmPhone"]</dt>
                <dd class="mt-1 text-slate-700 dark:text-slate-200">
                    @if (string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <span class="text-slate-400">—</span>
                    }
                    else
                    {
                        <a href="tel:@Model.Phone" class="hover:text-[#00B2EC] transition-colors">@Model.Phone</a>
                    }
                </dd>
            </div>

            <div class="sm:col-span-2">
                <dt class="text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-slate-500">@SharedLocalizer["CrmCompanyName"]</dt>
                <dd class="mt-1 text-slate-700 dark:text-slate-200">
                    @if (Model.Company is null)
                    {
                        <span class="text-slate-400">@SharedLocalizer["CrmNotLinkedToCompany"]</span>
                    }
                    else
                    {
                        <a asp-controller="CrmCompany" asp-action="Details" asp-route-id="@Model.Company.Id"
                           class="inline-flex items-center gap-1.5 hover:text-[#00B2EC] transition-colors">
                            <span class="material-symbols-outlined text-[18px]">apartment</span>
                            @Model.Company.Name
                        </a>
                    }
                </dd>
            </div>
        </dl>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="mt-6 pt-6 border-t border-slate-200 dark:border-white/10">
                <dt class="text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-slate-500">@SharedLocalizer["CrmNotes"]</dt>
                <dd class="mt-2 text-sm text-slate-700 dark:text-slate-200 whitespace-pre-line">@Model.Notes</dd>
            </div>
        }

        <div class="mt-6 pt-6 border-t border-slate-200 dark:border-white/10 flex flex-wrap gap-x-8 gap-y-2 text-xs text-slate-400 dark:text-slate-500">
            <span>@SharedLocalizer["CrmCreated"] @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</span>
            <span>@SharedLocalizer["CrmUpdated"] @Model.UpdatedAt.ToString("dd MMM yyyy, HH:mm") UTC</span>
        </div>
    </div>

    <div class="mt-6 space-y-6">
        @await Component.InvokeAsync("RecordTasks", new { entityType = CrmEntityType.Contact, entityId = Model.Id })
        @await Component.InvokeAsync("RecordActivity", new { entityType = CrmEntityType.Contact, entityId = Model.Id })
    </div>
</div>

